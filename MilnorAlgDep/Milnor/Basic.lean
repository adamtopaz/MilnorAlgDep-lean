module

public import MilnorAlgDep.Milnor.Defs
public import Mathlib.LinearAlgebra.TensorProduct.Lift

/-!
# Basic properties of rational Milnor K-rings

Blueprint, Section 1.2 (the grading, `τ_*` and `r^deg`) and the start of Section 7.

This file collects the elementary facts about `MilnorKQ H` (see `MilnorAlgDep.Milnor.Defs`) used
in the proofs of Theorems B, C and D.

## Main statements

* `MilnorKQ.ι_injective`, `MilnorKQ.grade_zero`, `MilnorKQ.grade_one`: the degree zero part is
  `ℚ` and the degree one part is `VOf H` (embedded by `ι`).
* `MilnorKQ.induction`: an induction principle (`MilnorKQ H` is generated by `ι`).
* `MilnorKQ.IsGraded.apply_ι`: a graded homomorphism `φ` satisfies `φ (ι v) = ι (φ₁ v)`;
  `MilnorKQ.isGraded_iff` is the converse; `MilnorKQ.IsGraded.ext`: graded homomorphisms are
  determined by their degree one part.
* `MilnorKQ.isGraded_map`, `MilnorKQ.isGraded_degScale`, `MilnorKQ.IsGraded.comp`,
  `MilnorKQ.isGraded_id` and the corresponding formulas `degOne_map`, `degOne_degScale`,
  `degOne_comp`, `degOne_id`.
* `MilnorKQ.map_comp`, `MilnorKQ.map_id`, `MilnorKQ.degScale_comp_map`,
  `MilnorKQ.degScale_comp_degScale`, `MilnorKQ.degScale_one`; `MilnorKQ.degScaleEquiv r` is
  `r^deg` as an algebra automorphism for `r ≠ 0`; `MilnorKQ.degScale_apply_of_mem_grade`:
  `r^deg` is multiplication by `r ^ n` in degree `n`.
* `MilnorKQ.proj`: the projection `MilnorKQ H → MilnorKQ H'` for subgroups `H ≤ H'` of `Lˣ`
  (for instance `𝒦_*(L) → 𝒦_*(L|l)`).
* `VOf.lift`: the `ℚ`-linear map `VOf H → W` induced by an additive map `Lˣ → W` vanishing on
  `H`.
-/

@[expose] public section

namespace MilnorAlgDep

open VOf

variable {K L M : Type*} [Field K] [Field L] [Field M]

namespace VOf

-- TODO(move): this section belongs in `MilnorAlgDep/Foundations/VOf.lean`.
section lift

variable {H : Subgroup Lˣ} {W : Type*} [AddCommGroup W] [Module ℚ W]

/-- The `ℚ`-linear map `VOf H → W` into a `ℚ`-vector space induced by an additive map
`f : Additive Lˣ →+ W` vanishing on `H`; it sends `[a]` to `f a` (`lift_cls`). -/
noncomputable def lift (f : Additive Lˣ →+ W) (hf : ∀ a ∈ H, f (.ofMul a) = 0) :
    VOf H →ₗ[ℚ] W :=
  LinearMap.liftBaseChange ℚ
    (MonoidHom.toAdditiveLeft
      (QuotientGroup.lift H (MonoidHom.toAdditiveLeft.symm f) fun a ha ↦ by
        rw [MonoidHom.mem_ker]
        exact congrArg Multiplicative.ofAdd (hf a ha))).toIntLinearMap

@[simp]
theorem lift_cls (f : Additive Lˣ →+ W) (hf : ∀ a ∈ H, f (.ofMul a) = 0) (a : Lˣ) :
    lift f hf (cls H (.ofMul a)) = f (.ofMul a) := by
  rw [cls_apply, lift]
  exact one_smul ℚ (f (.ofMul a))

/-- `lift` composed with a projection. -/
theorem lift_comp_proj {H' : Subgroup Lˣ} (h : H ≤ H') (f : Additive Lˣ →+ W)
    (hf : ∀ a ∈ H', f (.ofMul a) = 0) :
    lift f hf ∘ₗ proj h = lift f fun a ha ↦ hf a (h ha) :=
  linearMap_ext fun a ↦ by rw [LinearMap.comp_apply, proj_cls, lift_cls, lift_cls]

end lift

theorem proj_comp_proj {H H' H'' : Subgroup Lˣ} (h : H ≤ H') (h' : H' ≤ H'') :
    proj h' ∘ₗ proj h = proj (h.trans h') :=
  linearMap_ext fun a ↦ by rw [LinearMap.comp_apply, proj_cls, proj_cls, proj_cls]

@[simp]
theorem proj_self {H : Subgroup Lˣ} : proj (le_refl H) = LinearMap.id :=
  linearMap_ext fun a ↦ by rw [proj_cls, LinearMap.id_apply]

theorem _root_.Subgroup.comap_units_map_ringHom_id (H : Subgroup Lˣ) :
    H.comap (Units.map (RingHom.id L : L →* L)) = H :=
  Subgroup.ext fun _ ↦ Iff.rfl

theorem mapRingHom_id {H H' : Subgroup Lˣ}
    (h : H ≤ H'.comap (Units.map (RingHom.id L : L →* L))) :
    mapRingHom (RingHom.id L) h = proj (h.trans (Subgroup.comap_units_map_ringHom_id H').le) := by
  refine linearMap_ext fun a ↦ ?_
  rw [mapRingHom_cls, proj_cls]
  rfl

theorem mapRingHom_comp {H₀ : Subgroup Kˣ} {H : Subgroup Lˣ} {H' : Subgroup Mˣ} (τ : K →+* L)
    (σ : L →+* M) (h : H₀ ≤ H.comap (Units.map (τ : K →* L)))
    (h' : H ≤ H'.comap (Units.map (σ : L →* M))) :
    mapRingHom σ h' ∘ₗ mapRingHom τ h =
      mapRingHom (σ.comp τ)
        (fun _ hx ↦ Subgroup.mem_comap.2 (Subgroup.mem_comap.1 (h' (h hx)))) := by
  refine linearMap_ext fun a ↦ ?_
  rw [LinearMap.comp_apply, mapRingHom_cls, mapRingHom_cls, mapRingHom_cls]
  rfl

end VOf

namespace MilnorKQ

section Basic

variable {H : Subgroup Lˣ}

theorem ι_injective : Function.Injective (ι H) :=
  Function.LeftInverse.injective (π₁_ι H)

@[simp]
theorem ι_inj {v w : VOf H} : ι H v = ι H w ↔ v = w :=
  ι_injective.eq_iff

@[simp]
theorem ι_eq_zero_iff {v : VOf H} : ι H v = 0 ↔ v = 0 := by
  rw [← map_zero (ι H), ι_inj]

theorem ι_cls (a : Lˣ) : ι H (cls H (.ofMul a)) = ι H 〚a〛 := rfl

theorem symbol_def (a b : Lˣ) : symbol H a b = ι H 〚a〛 * ι H 〚b〛 := rfl

/-- Induction principle for `MilnorKQ H`: it is generated as a `ℚ`-algebra by the image of `ι`. -/
@[elab_as_elim]
theorem induction {C : MilnorKQ H → Prop}
    (algebraMap : ∀ r, C (algebraMap ℚ (MilnorKQ H) r)) (ι : ∀ v, C (ι H v))
    (mul : ∀ a b, C a → C b → C (a * b)) (add : ∀ a b, C a → C b → C (a + b))
    (x : MilnorKQ H) : C x := by
  obtain ⟨t, rfl⟩ := RingQuot.mkAlgHom_surjective ℚ (SteinbergRel H) x
  induction t using TensorAlgebra.induction with
  | algebraMap r => exact (AlgHom.commutes (mkAlgHom H) r).symm ▸ algebraMap r
  | ι v => exact ι v
  | mul a b ha hb => exact (map_mul (mkAlgHom H) a b).symm ▸ mul _ _ ha hb
  | add a b ha hb => exact (map_add (mkAlgHom H) a b).symm ▸ add _ _ ha hb

/-- Two `ℚ`-linear maps out of `MilnorKQ H` (into a module) agreeing on `1` and on all products
`ι v * x` are equal. -/
theorem linearMap_ext {W : Type*} [AddCommGroup W] [Module ℚ W] {f g : MilnorKQ H →ₗ[ℚ] W}
    (one : f 1 = g 1) (mul : ∀ v x, f x = g x → f (ι H v * x) = g (ι H v * x)) : f = g := by
  -- every `y` maps the equalizer of `f` and `g` into itself
  have key : ∀ y x : MilnorKQ H, f x = g x → f (y * x) = g (y * x) := by
    intro y
    induction y using induction with
    | algebraMap r =>
      intro x hx
      rw [← Algebra.smul_def, map_smul, map_smul, hx]
    | ι v => exact mul v
    | mul a b ha hb => exact fun x hx ↦ by rw [mul_assoc]; exact ha _ (hb x hx)
    | add a b ha hb => exact fun x hx ↦ by rw [add_mul, map_add, map_add, ha x hx, hb x hx]
  exact LinearMap.ext fun y ↦ by simpa using key y 1 one

end Basic

section Grading

variable {H : Subgroup Lˣ}

theorem grade_zero : grade H 0 = LinearMap.range (Algebra.linearMap ℚ (MilnorKQ H)) := by
  rw [grade, pow_zero, Submodule.one_eq_range]

theorem mem_grade_zero_iff {x : MilnorKQ H} :
    x ∈ grade H 0 ↔ ∃ q : ℚ, algebraMap ℚ (MilnorKQ H) q = x := by
  rw [grade_zero]
  rfl

theorem algebraMap_mem_grade_zero (q : ℚ) : algebraMap ℚ (MilnorKQ H) q ∈ grade H 0 :=
  mem_grade_zero_iff.2 ⟨q, rfl⟩

theorem one_mem_grade_zero : (1 : MilnorKQ H) ∈ grade H 0 := by
  simpa using algebraMap_mem_grade_zero (H := H) 1

theorem grade_one : grade H 1 = LinearMap.range (ι H) :=
  pow_one _

theorem mem_grade_one_iff {x : MilnorKQ H} : x ∈ grade H 1 ↔ ∃ v, ι H v = x := by
  rw [grade_one]
  rfl

theorem mul_mem_grade {m n : ℕ} {x y : MilnorKQ H} (hx : x ∈ grade H m) (hy : y ∈ grade H n) :
    x * y ∈ grade H (m + n) := by
  rw [grade, pow_add]
  exact Submodule.mul_mem_mul hx hy

theorem ι_mul_mem_grade {n : ℕ} (v : VOf H) {x : MilnorKQ H} (hx : x ∈ grade H n) :
    ι H v * x ∈ grade H (n + 1) := by
  rw [add_comm]
  exact mul_mem_grade (ι_mem_grade_one H v) hx

theorem ι_mul_ι_mem_grade_two (v w : VOf H) : ι H v * ι H w ∈ grade H 2 :=
  mul_mem_grade (ι_mem_grade_one H v) (ι_mem_grade_one H w)

theorem symbol_mem_grade_two (a b : Lˣ) : symbol H a b ∈ grade H 2 :=
  ι_mul_ι_mem_grade_two _ _

end Grading

section Graded

variable {H : Subgroup Lˣ} {H' : Subgroup Kˣ} {H'' : Subgroup Mˣ}

theorem degOne_apply (φ : MilnorKQ H →ₐ[ℚ] MilnorKQ H') (v : VOf H) :
    degOne φ v = π₁ H' (φ (ι H v)) :=
  rfl

/-- If `φ (ι v) = ι (f v)` for all `v`, then `φ₁ = f`. -/
theorem degOne_eq_of_apply_ι {φ : MilnorKQ H →ₐ[ℚ] MilnorKQ H'} {f : VOf H →ₗ[ℚ] VOf H'}
    (h : ∀ v, φ (ι H v) = ι H' (f v)) : degOne φ = f :=
  LinearMap.ext fun v ↦ by rw [degOne_apply, h, π₁_ι]

/-- If `φ (ι v) = ι (f v)` for all `v`, then `φ` is graded. -/
theorem isGraded_of_apply_ι {φ : MilnorKQ H →ₐ[ℚ] MilnorKQ H'} {f : VOf H →ₗ[ℚ] VOf H'}
    (h : ∀ v, φ (ι H v) = ι H' (f v)) : IsGraded φ := by
  intro n
  rw [grade, grade, Submodule.map_pow]
  refine pow_le_pow_left' ?_ n
  rintro _ ⟨_, ⟨v, rfl⟩, rfl⟩
  exact ⟨f v, (h v).symm⟩

namespace IsGraded

variable {φ : MilnorKQ H →ₐ[ℚ] MilnorKQ H'}

/-- A graded homomorphism maps degree one into degree one. -/
theorem apply_ι_mem_range (hφ : IsGraded φ) (v : VOf H) :
    φ (ι H v) ∈ LinearMap.range (ι H') := by
  rw [← grade_one]
  exact hφ 1 (Submodule.mem_map_of_mem (ι_mem_grade_one H v))

/-- A graded homomorphism `φ` satisfies `φ (ι v) = ι (φ₁ v)`. -/
theorem apply_ι (hφ : IsGraded φ) (v : VOf H) : φ (ι H v) = ι H' (degOne φ v) := by
  obtain ⟨w, hw⟩ := hφ.apply_ι_mem_range v
  rw [degOne_apply, ← hw, π₁_ι]

theorem comp_ι (hφ : IsGraded φ) : φ.toLinearMap ∘ₗ ι H = ι H' ∘ₗ degOne φ :=
  LinearMap.ext hφ.apply_ι

/-- A graded homomorphism `φ` maps the symbol `{a, b}` to `φ₁ [a] * φ₁ [b]`. -/
theorem apply_symbol (hφ : IsGraded φ) (a b : Lˣ) :
    φ (symbol H a b) = ι H' (degOne φ 〚a〛) * ι H' (degOne φ 〚b〛) := by
  rw [symbol, map_mul, hφ.apply_ι, hφ.apply_ι]

/-- Graded homomorphisms are determined by their degree one parts. -/
theorem ext {ψ : MilnorKQ H →ₐ[ℚ] MilnorKQ H'} (hφ : IsGraded φ) (hψ : IsGraded ψ)
    (h : degOne φ = degOne ψ) : φ = ψ :=
  algHom_ext (by rw [hφ.comp_ι, hψ.comp_ι, h])

theorem eq_iff {ψ : MilnorKQ H →ₐ[ℚ] MilnorKQ H'} (hφ : IsGraded φ) (hψ : IsGraded ψ) :
    φ = ψ ↔ degOne φ = degOne ψ :=
  ⟨fun h ↦ h ▸ rfl, hφ.ext hψ⟩

/-- The composition of graded homomorphisms is graded. -/
theorem comp {ψ : MilnorKQ H' →ₐ[ℚ] MilnorKQ H''} (hψ : IsGraded ψ) (hφ : IsGraded φ) :
    IsGraded (ψ.comp φ) := fun n ↦ by
  rw [AlgHom.comp_toLinearMap, Submodule.map_comp]
  exact (Submodule.map_mono (hφ n)).trans (hψ n)

end IsGraded

/-- `φ` is graded if and only if `φ (ι v) = ι (φ₁ v)` for all `v`. -/
theorem isGraded_iff {φ : MilnorKQ H →ₐ[ℚ] MilnorKQ H'} :
    IsGraded φ ↔ ∀ v, φ (ι H v) = ι H' (degOne φ v) :=
  ⟨IsGraded.apply_ι, isGraded_of_apply_ι⟩

theorem isGraded_id : IsGraded (AlgHom.id ℚ (MilnorKQ H)) :=
  isGraded_of_apply_ι (f := LinearMap.id) fun _ ↦ rfl

@[simp]
theorem degOne_id : degOne (AlgHom.id ℚ (MilnorKQ H)) = LinearMap.id :=
  degOne_eq_of_apply_ι fun _ ↦ rfl

/-- The degree one part of a composition: `(ψ ∘ φ)₁ = ψ₁ ∘ φ₁` if `φ` is graded. -/
theorem degOne_comp {φ : MilnorKQ H →ₐ[ℚ] MilnorKQ H'} (ψ : MilnorKQ H' →ₐ[ℚ] MilnorKQ H'')
    (hφ : IsGraded φ) : degOne (ψ.comp φ) = degOne ψ ∘ₗ degOne φ :=
  LinearMap.ext fun v ↦ by
    rw [degOne_apply, AlgHom.comp_apply, hφ.apply_ι]
    rfl

end Graded

section Projection

variable {H H' H'' : Subgroup Lˣ}

/-- The projection `MilnorKQ H → MilnorKQ H'` for subgroups `H ≤ H'` of `Lˣ`, sending `ι [a]` to
`ι [a]`. For instance, `proj bot_le : 𝒦_*(L) → 𝒦_*(L|l)` is the quotient map. -/
noncomputable def proj (h : H ≤ H') : MilnorKQ H →ₐ[ℚ] MilnorKQ H' :=
  lift (ι H' ∘ₗ VOf.proj h) fun a b hab ↦ by
    simp only [LinearMap.comp_apply, proj_cls]
    exact ι_mul_ι_eq_zero H' hab

@[simp]
theorem proj_ι (h : H ≤ H') (v : VOf H) : proj h (ι H v) = ι H' (VOf.proj h v) := by
  simp [proj]

theorem proj_symbol (h : H ≤ H') (a b : Lˣ) : proj h (symbol H a b) = symbol H' a b := by
  rw [symbol, map_mul, proj_ι, proj_ι, proj_cls, proj_cls, symbol]

theorem isGraded_proj (h : H ≤ H') : IsGraded (proj h) :=
  isGraded_of_apply_ι (proj_ι h)

@[simp]
theorem degOne_proj (h : H ≤ H') : degOne (proj h) = VOf.proj h :=
  degOne_eq_of_apply_ι (proj_ι h)

theorem proj_comp_proj (h : H ≤ H') (h' : H' ≤ H'') :
    (proj h').comp (proj h) = proj (h.trans h') :=
  algHom_ext <| LinearMap.ext fun v ↦ by
    simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply, proj_ι]
    rw [← LinearMap.comp_apply (VOf.proj h'), VOf.proj_comp_proj]

@[simp]
theorem proj_self : proj (le_refl H) = AlgHom.id ℚ (MilnorKQ H) :=
  algHom_ext <| LinearMap.ext fun v ↦ by simp

end Projection

section Functoriality

variable {H₀ : Subgroup Kˣ} {H : Subgroup Lˣ} {H' : Subgroup Mˣ}

theorem isGraded_map (τ : K →+* L) (h : H₀ ≤ H.comap (Units.map (τ : K →* L))) :
    IsGraded (map τ h) :=
  isGraded_of_apply_ι (map_ι τ h)

@[simp]
theorem degOne_map (τ : K →+* L) (h : H₀ ≤ H.comap (Units.map (τ : K →* L))) :
    degOne (map τ h) = mapRingHom τ h :=
  degOne_eq_of_apply_ι (map_ι τ h)

theorem map_symbol (τ : K →+* L) (h : H₀ ≤ H.comap (Units.map (τ : K →* L))) (a b : Kˣ) :
    map τ h (symbol H₀ a b) =
      symbol H (Units.map (τ : K →* L) a) (Units.map (τ : K →* L) b) := by
  rw [symbol, map_mul, map_ι, map_ι, mapRingHom_cls, mapRingHom_cls, symbol]

/-- Functoriality: `(σ ∘ τ)_* = σ_* ∘ τ_*`. -/
theorem map_comp (τ : K →+* L) (σ : L →+* M) (h : H₀ ≤ H.comap (Units.map (τ : K →* L)))
    (h' : H ≤ H'.comap (Units.map (σ : L →* M))) :
    (map σ h').comp (map τ h) =
      map (σ.comp τ) (fun _ hx ↦ Subgroup.mem_comap.2 (Subgroup.mem_comap.1 (h' (h hx)))) :=
  algHom_ext <| LinearMap.ext fun v ↦ by
    simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply, map_ι]
    rw [← LinearMap.comp_apply (mapRingHom σ h'), mapRingHom_comp]

/-- `map (RingHom.id L)` is the projection. -/
theorem map_id_eq_proj {H₁ : Subgroup Lˣ}
    (h : H₁ ≤ H.comap (Units.map (RingHom.id L : L →* L))) :
    map (RingHom.id L) h = proj (h.trans (Subgroup.comap_units_map_ringHom_id H).le) :=
  algHom_ext <| LinearMap.ext fun v ↦ by simp [mapRingHom_id]

/-- Functoriality: `id_* = id`. -/
@[simp]
theorem map_id (h : H ≤ H.comap (Units.map (RingHom.id L : L →* L))) :
    map (RingHom.id L) h = AlgHom.id ℚ (MilnorKQ H) := by
  rw [map_id_eq_proj, proj_self]

end Functoriality

section DegScale

variable {H₀ : Subgroup Kˣ} {H : Subgroup Lˣ}

theorem isGraded_degScale (r : ℚ) : IsGraded (degScale H r) :=
  isGraded_of_apply_ι (f := r • LinearMap.id) fun v ↦ by
    rw [degScale_ι, LinearMap.smul_apply, LinearMap.id_apply, map_smul]

@[simp]
theorem degOne_degScale (r : ℚ) : degOne (degScale H r) = r • LinearMap.id :=
  degOne_eq_of_apply_ι fun v ↦ by
    rw [degScale_ι, LinearMap.smul_apply, LinearMap.id_apply, map_smul]

@[simp]
theorem degScale_one : degScale H 1 = AlgHom.id ℚ (MilnorKQ H) :=
  algHom_ext <| LinearMap.ext fun v ↦ by simp

@[simp]
theorem degScale_zero_ι (v : VOf H) : degScale H 0 (ι H v) = 0 := by
  simp

/-- `r^deg ∘ s^deg = (r s)^deg`. -/
theorem degScale_comp_degScale (r s : ℚ) :
    (degScale H r).comp (degScale H s) = degScale H (r * s) :=
  algHom_ext <| LinearMap.ext fun v ↦ by simp [smul_smul, mul_comm]

/-- `r^deg` commutes with `τ_*`. -/
theorem degScale_comp_map (r : ℚ) (τ : K →+* L) (h : H₀ ≤ H.comap (Units.map (τ : K →* L))) :
    (degScale H r).comp (map τ h) = (map τ h).comp (degScale H₀ r) :=
  algHom_ext <| LinearMap.ext fun v ↦ by simp

/-- `r^deg` commutes with the projections. -/
theorem degScale_comp_proj {H' : Subgroup Lˣ} (r : ℚ) (h : H ≤ H') :
    (degScale H' r).comp (proj h) = (proj h).comp (degScale H r) :=
  algHom_ext <| LinearMap.ext fun v ↦ by simp

/-- The degree one part of `r^deg ∘ τ_*` is `r • [τ]`. -/
theorem degOne_degScale_comp_map (r : ℚ) (τ : K →+* L)
    (h : H₀ ≤ H.comap (Units.map (τ : K →* L))) :
    degOne ((degScale H r).comp (map τ h)) = r • mapRingHom τ h := by
  rw [degOne_comp _ (isGraded_map τ h), degOne_degScale, LinearMap.smul_comp, LinearMap.id_comp,
    degOne_map]

/-- Blueprint 1.2: `r^deg` is multiplication by `r ^ n` in degree `n`. -/
theorem degScale_apply_of_mem_grade (r : ℚ) {n : ℕ} {x : MilnorKQ H} (hx : x ∈ grade H n) :
    degScale H r x = r ^ n • x := by
  induction hx using Submodule.pow_induction_on_left' with
  | algebraMap q => simp
  | add x y n _ _ hx hy => rw [map_add, hx, hy, smul_add]
  | mem_mul m hm n x _ hx =>
    obtain ⟨v, rfl⟩ := hm
    rw [map_mul, hx, degScale_ι, smul_mul_smul_comm, pow_succ', mul_comm]

/-- `r^deg` as an algebra automorphism, for `r ≠ 0`. -/
noncomputable def degScaleEquiv (r : ℚ) (hr : r ≠ 0) : MilnorKQ H ≃ₐ[ℚ] MilnorKQ H :=
  AlgEquiv.ofAlgHom (degScale H r) (degScale H r⁻¹)
    (by rw [degScale_comp_degScale, mul_inv_cancel₀ hr, degScale_one])
    (by rw [degScale_comp_degScale, inv_mul_cancel₀ hr, degScale_one])

@[simp]
theorem degScaleEquiv_toAlgHom (r : ℚ) (hr : r ≠ 0) :
    (degScaleEquiv (H := H) r hr).toAlgHom = degScale H r :=
  rfl

@[simp]
theorem degScaleEquiv_apply (r : ℚ) (hr : r ≠ 0) (x : MilnorKQ H) :
    degScaleEquiv r hr x = degScale H r x :=
  rfl

@[simp]
theorem degScaleEquiv_symm (r : ℚ) (hr : r ≠ 0) :
    (degScaleEquiv (H := H) r hr).symm = degScaleEquiv r⁻¹ (inv_ne_zero hr) :=
  AlgEquiv.ext fun _ ↦ rfl

theorem degScale_bijective {r : ℚ} (hr : r ≠ 0) : Function.Bijective (degScale H r) :=
  (degScaleEquiv r hr).bijective

end DegScale

end MilnorKQ

end MilnorAlgDep
