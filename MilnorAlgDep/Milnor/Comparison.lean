@[expose] public section

namespace MilnorAlgDep

open VOf TensorProduct

variable {K L M : Type*} [Field K] [Field L] [Field M]

/-! ### The integral Milnor ring -/

namespace MilnorK

variable (L) in
/-- The Steinberg relations on the tensor algebra `T_ℤ(Lˣ)` of the abelian group `Lˣ` (written
additively): `ι a * ι b` is related to `0` whenever `a + b = 1` in `L`. -/
inductive SteinbergRel : TensorAlgebra ℤ (Additive Lˣ) → TensorAlgebra ℤ (Additive Lˣ) → Prop
  | mk (a b : Lˣ) (hab : (a : L) + b = 1) :
      SteinbergRel (TensorAlgebra.ι ℤ (.ofMul a) * TensorAlgebra.ι ℤ (.ofMul b)) 0

end MilnorK

/-- Blueprint 1.2: the Milnor ring `K^M_*(L)` of a field `L`: the quotient of the tensor algebra
`T_ℤ(Lˣ)` of the abelian group `Lˣ` (written additively) by the two-sided ideal generated by the
Steinberg elements `a ⊗ b` with `a + b = 1`, i.e. `x ⊗ (1 - x)` for `x ≠ 0, 1`. -/
def MilnorK (L : Type*) [Field L] : Type _ :=
  RingQuot (MilnorK.SteinbergRel L)

namespace MilnorK

noncomputable instance : Ring (MilnorK L) :=
  inferInstanceAs (Ring (RingQuot (SteinbergRel L)))

variable (L)

/-- The quotient map `T_ℤ(Lˣ) → K^M_*(L)`. -/
noncomputable def mkRingHom : TensorAlgebra ℤ (Additive Lˣ) →+* MilnorK L :=
  RingQuot.mkRingHom (SteinbergRel L)

/-- The inclusion of degree one, `Lˣ → K^M_1(L)`, `a ↦ {a}`. -/
noncomputable def ι : Additive Lˣ →+ MilnorK L :=
  (mkRingHom L).toAddMonoidHom.comp (TensorAlgebra.ι ℤ).toAddMonoidHom

/-- The symbol `{a, b} = ι a * ι b ∈ K^M_2(L)`. -/
noncomputable def symbol (a b : Lˣ) : MilnorK L :=
  ι L (.ofMul a) * ι L (.ofMul b)

theorem ι_apply (a : Additive Lˣ) : ι L a = mkRingHom L (TensorAlgebra.ι ℤ a) :=
  rfl

/-- The Steinberg relation: `ι a * ι b = 0` if `a + b = 1`. -/
theorem ι_mul_ι_eq_zero {a b : Lˣ} (hab : (a : L) + b = 1) :
    ι L (.ofMul a) * ι L (.ofMul b) = 0 := by
  have h := RingQuot.mkRingHom_rel (SteinbergRel.mk a b hab)
  rw [map_mul, map_zero] at h
  exact h

/-- The Steinberg relation: `{a, b} = 0` if `a + b = 1`. -/
theorem symbol_eq_zero {a b : Lˣ} (hab : (a : L) + b = 1) : symbol L a b = 0 :=
  ι_mul_ι_eq_zero L hab

variable {L}

/-- The universal property of `K^M_*(L)`: an additive map `f : Lˣ → A` into a ring with
`f a * f b = 0` whenever `a + b = 1` extends to a ring homomorphism `K^M_*(L) → A`. -/
noncomputable def lift {A : Type*} [Ring A] (f : Additive Lˣ →+ A)
    (hf : ∀ a b : Lˣ, (a : L) + b = 1 → f (.ofMul a) * f (.ofMul b) = 0) : MilnorK L →+* A :=
  RingQuot.lift ⟨(TensorAlgebra.lift ℤ f.toIntLinearMap).toRingHom, fun _ _ h ↦ by
    cases h with
    | mk a b hab =>
      rw [map_mul, map_zero, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
        TensorAlgebra.lift_ι_apply, TensorAlgebra.lift_ι_apply]
      exact hf a b hab⟩

@[simp]
theorem lift_ι {A : Type*} [Ring A] (f : Additive Lˣ →+ A)
    (hf : ∀ a b : Lˣ, (a : L) + b = 1 → f (.ofMul a) * f (.ofMul b) = 0) (a : Additive Lˣ) :
    lift f hf (ι L a) = f a :=
  (RingQuot.lift_mkRingHom_apply (TensorAlgebra.lift ℤ f.toIntLinearMap).toRingHom _
    (TensorAlgebra.ι ℤ a)).trans (TensorAlgebra.lift_ι_apply f.toIntLinearMap a)

/-- Two ring homomorphisms out of `K^M_*(L)` agreeing on all `ι a` are equal. -/
theorem ringHom_ext {A : Type*} [Semiring A] {f g : MilnorK L →+* A}
    (h : ∀ a : Lˣ, f (ι L (.ofMul a)) = g (ι L (.ofMul a))) : f = g := by
  refine RingQuot.ringQuot_ext f g (RingHom.ext fun t ↦ ?_)
  induction t using TensorAlgebra.induction with
  | algebraMap r =>
    exact RingHom.congr_fun (RingHom.ext_int ((f.comp (mkRingHom L)).comp (algebraMap ℤ _))
      ((g.comp (mkRingHom L)).comp (algebraMap ℤ _))) r
  | ι v => exact h (Additive.toMul v)
  | mul a b ha hb => rw [map_mul, map_mul, ha, hb]
  | add a b ha hb => rw [map_add, map_add, ha, hb]

/-- Two `ℤ`-algebra homomorphisms out of `K^M_*(L)` agreeing on all `ι a` are equal. -/
theorem intAlgHom_ext {A : Type*} [Ring A] [Algebra ℤ A] {f g : MilnorK L →ₐ[ℤ] A}
    (h : ∀ a : Lˣ, f (ι L (.ofMul a)) = g (ι L (.ofMul a))) : f = g :=
  AlgHom.toRingHom_injective (ringHom_ext h)

section Functoriality

/-- The homomorphism `τ_* : K^M_*(K) → K^M_*(L)` induced by a ring homomorphism `τ : K →+* L`;
it sends `ι a` to `ι (τ a)`. -/
noncomputable def map (τ : K →+* L) : MilnorK K →+* MilnorK L :=
  lift ((ι L).comp (Units.map (τ : K →* L)).toAdditive) fun a b hab ↦ by
    refine ι_mul_ι_eq_zero L ?_
    change τ a + τ b = 1
    rw [← map_add, hab, map_one]

@[simp]
theorem map_ι (τ : K →+* L) (a : Kˣ) :
    map τ (ι K (.ofMul a)) = ι L (.ofMul (Units.map (τ : K →* L) a)) := by
  rw [map, lift_ι]
  rfl

theorem map_symbol (τ : K →+* L) (a b : Kˣ) :
    map τ (symbol K a b) = symbol L (Units.map (τ : K →* L) a) (Units.map (τ : K →* L) b) := by
  rw [symbol, map_mul, map_ι, map_ι, symbol]

@[simp]
theorem map_id : map (RingHom.id L) = RingHom.id (MilnorK L) :=
  ringHom_ext fun a ↦ by rw [map_ι]; rfl

theorem map_comp (τ : K →+* L) (σ : L →+* M) : (map σ).comp (map τ) = map (σ.comp τ) :=
  ringHom_ext fun a ↦ by
    rw [RingHom.comp_apply, map_ι, map_ι, map_ι]
    rfl

end Functoriality

section Grading

variable (L) in
/-- The degree `n` part `K^M_n(L)` of `K^M_*(L)`: the subgroup generated by the products of `n`
elements of degree one, i.e. `(range ι) ^ n`. -/
noncomputable def grade (n : ℕ) : Submodule ℤ (MilnorK L) :=
  LinearMap.range (ι L).toIntLinearMap ^ n

theorem ι_mem_grade_one (a : Additive Lˣ) : ι L a ∈ grade L 1 := by
  rw [grade, pow_one]
  exact LinearMap.mem_range_self (ι L).toIntLinearMap a

theorem symbol_mem_grade_two (a b : Lˣ) : symbol L a b ∈ grade L 2 := by
  rw [grade, pow_two]
  exact Submodule.mul_mem_mul (LinearMap.mem_range_self _ _) (LinearMap.mem_range_self _ _)

end Grading

end MilnorK

/-! ### The rational comparison `ℚ ⊗ K^M_*(L) ≅ 𝒦_*(L)` -/

namespace VOf

variable (L) in
/-- The degree one part of the comparison: `VOf ⊥ = ℚ ⊗[ℤ] Additive (Lˣ ⧸ ⊥)` is
`ℚ ⊗[ℤ] Additive Lˣ = L^× ⊗ ℚ`. -/
noncomputable def botEquiv : VOf (⊥ : Subgroup Lˣ) ≃ₗ[ℚ] ℚ ⊗[ℤ] Additive Lˣ :=
  LinearEquiv.baseChange ℤ ℚ _ _ (QuotientGroup.quotientBot.toAdditive.toIntLinearEquiv)

@[simp]
theorem botEquiv_cls (a : Lˣ) : botEquiv L (cls ⊥ (.ofMul a)) = (1 : ℚ) ⊗ₜ .ofMul a :=
  rfl

@[simp]
theorem botEquiv_symm_tmul (a : Lˣ) :
    (botEquiv L).symm ((1 : ℚ) ⊗ₜ .ofMul a) = cls ⊥ (.ofMul a) := by
  rw [← botEquiv_cls, LinearEquiv.symm_apply_apply]

end VOf

namespace MilnorK

variable (L)

/-- The ring homomorphism `K^M_*(L) → 𝒦_*(L) = MilnorKQ ⊥`, `ι a ↦ ι [a]`. -/
noncomputable def toMilnorKQ : MilnorK L →+* MilnorKQ (⊥ : Subgroup Lˣ) :=
  lift ((MilnorKQ.ι ⊥).toAddMonoidHom.comp (cls ⊥)) fun _ _ hab ↦ MilnorKQ.ι_mul_ι_eq_zero ⊥ hab

@[simp]
theorem toMilnorKQ_ι (a : Lˣ) :
    toMilnorKQ L (ι L (.ofMul a)) = MilnorKQ.ι ⊥ (cls ⊥ (.ofMul a)) :=
  lift_ι _ _ _

/-- The `ℚ`-linear map `VOf ⊥ → ℚ ⊗[ℤ] K^M_*(L)`, `[a] ↦ 1 ⊗ ι a` (the degree one part of the
inverse comparison map). -/
noncomputable def ofVOf : VOf (⊥ : Subgroup Lˣ) →ₗ[ℚ] ℚ ⊗[ℤ] MilnorK L :=
  VOf.lift ((TensorProduct.mk ℤ ℚ (MilnorK L) 1).toAddMonoidHom.comp (ι L)) fun a ha ↦ by
    rw [Subgroup.mem_bot] at ha
    rw [ha, ofMul_one, map_zero]

@[simp]
theorem ofVOf_cls (a : Lˣ) : ofVOf L (cls ⊥ (.ofMul a)) = (1 : ℚ) ⊗ₜ ι L (.ofMul a) :=
  VOf.lift_cls _ _ a

/-- The algebra homomorphism `𝒦_*(L) = MilnorKQ ⊥ → ℚ ⊗[ℤ] K^M_*(L)`, `ι [a] ↦ 1 ⊗ ι a`. -/
noncomputable def ofMilnorKQ : MilnorKQ (⊥ : Subgroup Lˣ) →ₐ[ℚ] ℚ ⊗[ℤ] MilnorK L :=
  MilnorKQ.lift (ofVOf L) fun a b hab ↦ by
    rw [ofVOf_cls, ofVOf_cls, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
      ι_mul_ι_eq_zero L hab, tmul_zero]

@[simp]
theorem ofMilnorKQ_ι_cls (a : Lˣ) :
    ofMilnorKQ L (MilnorKQ.ι ⊥ (cls ⊥ (.ofMul a))) = (1 : ℚ) ⊗ₜ ι L (.ofMul a) := by
  rw [ofMilnorKQ, MilnorKQ.lift_ι, ofVOf_cls]

/-- The algebra homomorphism `ℚ ⊗[ℤ] K^M_*(L) → 𝒦_*(L) = MilnorKQ ⊥`, `q ⊗ x ↦ q • x`, obtained
from `toMilnorKQ` by base change. -/
noncomputable def ratToMilnorKQ : ℚ ⊗[ℤ] MilnorK L →ₐ[ℚ] MilnorKQ (⊥ : Subgroup Lˣ) :=
  AlgHom.liftEquiv ℤ ℚ (MilnorK L) (MilnorKQ ⊥) (toMilnorKQ L).toIntAlgHom

theorem ratToMilnorKQ_tmul (q : ℚ) (x : MilnorK L) :
    ratToMilnorKQ L (q ⊗ₜ x) = q • toMilnorKQ L x :=
  rfl

variable {L}

/-- Two `ℚ`-algebra homomorphisms out of `ℚ ⊗[ℤ] K^M_*(L)` agreeing on all `1 ⊗ ι a` are
equal. -/
theorem ratAlgHom_ext {A : Type*} [Ring A] [Algebra ℚ A] {f g : ℚ ⊗[ℤ] MilnorK L →ₐ[ℚ] A}
    (h : ∀ a : Lˣ, f ((1 : ℚ) ⊗ₜ ι L (.ofMul a)) = g ((1 : ℚ) ⊗ₜ ι L (.ofMul a))) : f = g :=
  Algebra.TensorProduct.ext_ring (intAlgHom_ext h)

variable (L)

theorem ofMilnorKQ_comp_ratToMilnorKQ :
    (ofMilnorKQ L).comp (ratToMilnorKQ L) = AlgHom.id ℚ _ :=
  ratAlgHom_ext fun a ↦ by
    rw [AlgHom.comp_apply, ratToMilnorKQ_tmul, one_smul, toMilnorKQ_ι, ofMilnorKQ_ι_cls,
      AlgHom.id_apply]

theorem ratToMilnorKQ_comp_ofMilnorKQ :
    (ratToMilnorKQ L).comp (ofMilnorKQ L) = AlgHom.id ℚ _ :=
  MilnorKQ.algHom_ext <| VOf.linearMap_ext fun a ↦ by
    simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply,
      AlgHom.id_apply]
    rw [ofMilnorKQ_ι_cls, ratToMilnorKQ_tmul, one_smul, toMilnorKQ_ι]

/-- **Comparison with the paper's `𝒦_*(L) = ℚ ⊗ K^M_*(L)`.** The isomorphism of `ℚ`-algebras
`ℚ ⊗[ℤ] K^M_*(L) ≃ MilnorKQ ⊥`, sending `q ⊗ ι a` to `q • ι [a]` (`ratEquiv_one_tmul_ι`), hence
`1 ⊗ {a, b}` to `{a, b}` (`ratEquiv_one_tmul_symbol`). -/
noncomputable def ratEquiv : ℚ ⊗[ℤ] MilnorK L ≃ₐ[ℚ] MilnorKQ (⊥ : Subgroup Lˣ) :=
  AlgEquiv.ofAlgHom (ratToMilnorKQ L) (ofMilnorKQ L) (ratToMilnorKQ_comp_ofMilnorKQ L)
    (ofMilnorKQ_comp_ratToMilnorKQ L)

theorem ratEquiv_tmul (q : ℚ) (x : MilnorK L) : ratEquiv L (q ⊗ₜ x) = q • toMilnorKQ L x :=
  rfl

theorem ratEquiv_one_tmul (x : MilnorK L) : ratEquiv L ((1 : ℚ) ⊗ₜ x) = toMilnorKQ L x := by
  rw [ratEquiv_tmul, one_smul]

/-- The comparison isomorphism in degree one: `1 ⊗ ι a ↦ ι [a]`. -/
@[simp]
theorem ratEquiv_one_tmul_ι (a : Lˣ) :
    ratEquiv L ((1 : ℚ) ⊗ₜ ι L (.ofMul a)) = MilnorKQ.ι ⊥ (cls ⊥ (.ofMul a)) := by
  rw [ratEquiv_one_tmul, toMilnorKQ_ι]

/-- The comparison isomorphism on symbols: `1 ⊗ {a, b} ↦ {a, b}`. -/
@[simp]
theorem ratEquiv_one_tmul_symbol (a b : Lˣ) :
    ratEquiv L ((1 : ℚ) ⊗ₜ symbol L a b) = MilnorKQ.symbol ⊥ a b := by
  rw [ratEquiv_one_tmul, symbol, map_mul, toMilnorKQ_ι, toMilnorKQ_ι, MilnorKQ.symbol]

@[simp]
theorem ratEquiv_symm_ι_cls (a : Lˣ) :
    (ratEquiv L).symm (MilnorKQ.ι ⊥ (cls ⊥ (.ofMul a))) = (1 : ℚ) ⊗ₜ ι L (.ofMul a) := by
  rw [AlgEquiv.symm_apply_eq, ratEquiv_one_tmul_ι]

/-- The comparison isomorphism in degree one, for all elements: under the identification
`VOf ⊥ ≃ ℚ ⊗[ℤ] Additive Lˣ` (`VOf.botEquiv`), the inverse of `ratEquiv` restricted to degree one
is `id_ℚ ⊗ ι`. -/
theorem ratEquiv_symm_ι (v : VOf (⊥ : Subgroup Lˣ)) :
    (ratEquiv L).symm (MilnorKQ.ι ⊥ v) =
      (ι L).toIntLinearMap.baseChange ℚ (VOf.botEquiv L v) := by
  refine LinearMap.congr_fun (f := (ratEquiv L).symm.toLinearMap ∘ₗ MilnorKQ.ι ⊥)
    (g := (ι L).toIntLinearMap.baseChange ℚ ∘ₗ (VOf.botEquiv L).toLinearMap)
    (VOf.linearMap_ext fun a ↦ ?_) v
  simp only [LinearMap.comp_apply, AlgEquiv.toLinearMap_apply, LinearEquiv.coe_coe,
    ratEquiv_symm_ι_cls, VOf.botEquiv_cls, LinearMap.baseChange_tmul]
  rfl

/-- The comparison isomorphism in degree one: `ratEquiv (q ⊗ ι a) = ι (q ⊗ a)`, where
`ℚ ⊗[ℤ] Additive Lˣ` is identified with `VOf ⊥` by `VOf.botEquiv`. -/
theorem ratEquiv_baseChange_ι (x : ℚ ⊗[ℤ] Additive Lˣ) :
    ratEquiv L ((ι L).toIntLinearMap.baseChange ℚ x) =
      MilnorKQ.ι ⊥ ((VOf.botEquiv L).symm x) := by
  rw [← AlgEquiv.eq_symm_apply, ratEquiv_symm_ι, LinearEquiv.apply_symm_apply]

section Functoriality

variable {L}

/-- The homomorphism `id_ℚ ⊗ τ_* : ℚ ⊗[ℤ] K^M_*(K) → ℚ ⊗[ℤ] K^M_*(L)` induced by a ring
homomorphism `τ : K →+* L`. -/
noncomputable def ratMap (τ : K →+* L) : ℚ ⊗[ℤ] MilnorK K →ₐ[ℚ] ℚ ⊗[ℤ] MilnorK L :=
  Algebra.TensorProduct.map (AlgHom.id ℚ ℚ) (map τ).toIntAlgHom

@[simp]
theorem ratMap_tmul (τ : K →+* L) (q : ℚ) (x : MilnorK K) : ratMap τ (q ⊗ₜ x) = q ⊗ₜ map τ x :=
  rfl

/-- The comparison isomorphism is compatible with the maps `τ_*` induced by a ring homomorphism
`τ : K →+* L`. -/
theorem ratEquiv_comp_ratMap (τ : K →+* L) :
    (ratEquiv L).toAlgHom.comp (ratMap τ) =
      (MilnorKQ.map τ bot_le).comp (ratEquiv K).toAlgHom :=
  ratAlgHom_ext fun a ↦ by
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, ratMap_tmul, map_ι, ratEquiv_one_tmul_ι,
      MilnorKQ.map_ι, mapRingHom_cls]

theorem ratEquiv_ratMap (τ : K →+* L) (x : ℚ ⊗[ℤ] MilnorK K) :
    ratEquiv L (ratMap τ x) = MilnorKQ.map τ bot_le (ratEquiv K x) :=
  AlgHom.congr_fun (ratEquiv_comp_ratMap τ) x

end Functoriality

section Grading

variable {L}

/-- `toMilnorKQ` is graded: it maps `K^M_n(L)` into `𝒦_n(L)`. -/
theorem toMilnorKQ_mem_grade {n : ℕ} {x : MilnorK L} (hx : x ∈ grade L n) :
    toMilnorKQ L x ∈ MilnorKQ.grade ⊥ n := by
  induction hx using Submodule.pow_induction_on_left' with
  | algebraMap r =>
    rw [algebraMap_int_eq, eq_intCast, map_intCast, ← map_intCast (algebraMap ℚ (MilnorKQ ⊥)) r]
    exact MilnorKQ.algebraMap_mem_grade_zero _
  | add x y i _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | mem_mul m hm i x _ hx =>
    obtain ⟨a, rfl⟩ := hm
    rw [map_mul, show toMilnorKQ L ((ι L).toIntLinearMap a) = MilnorKQ.ι ⊥ (cls ⊥ a) from
      toMilnorKQ_ι L (Additive.toMul a)]
    exact MilnorKQ.ι_mul_mem_grade _ hx

/-- The comparison isomorphism is graded: it maps `q ⊗ x` with `x ∈ K^M_n(L)` into `𝒦_n(L)`. -/
theorem ratEquiv_tmul_mem_grade (q : ℚ) {n : ℕ} {x : MilnorK L} (hx : x ∈ grade L n) :
    ratEquiv L (q ⊗ₜ x) ∈ MilnorKQ.grade ⊥ n := by
  rw [ratEquiv_tmul]
  exact Submodule.smul_mem _ q (toMilnorKQ_mem_grade hx)

theorem one_mem_grade_zero : (1 : MilnorK L) ∈ grade L 0 := by
  rw [grade, pow_zero]
  exact Submodule.one_le.1 le_rfl

variable (L) in
/-- The comparison isomorphism is graded: `𝒦_n(L)` is the `ℚ`-span of the image of
`1 ⊗ K^M_n(L)`. -/
theorem grade_bot_eq_span (n : ℕ) :
    MilnorKQ.grade (⊥ : Subgroup Lˣ) n =
      Submodule.span ℚ ((fun x ↦ ratEquiv L ((1 : ℚ) ⊗ₜ x)) '' grade L n) := by
  simp_rw [ratEquiv_one_tmul]
  refine le_antisymm (fun y hy ↦ ?_) (Submodule.span_le.2 ?_)
  · induction hy using Submodule.pow_induction_on_left' with
    | algebraMap q =>
      rw [Algebra.algebraMap_eq_smul_one]
      exact Submodule.smul_mem _ q (Submodule.subset_span ⟨1, one_mem_grade_zero, map_one _⟩)
    | add x y i _ _ hx hy => exact add_mem hx hy
    | mem_mul m hm i x _ hx =>
      obtain ⟨v, rfl⟩ := hm
      obtain ⟨k, a, -, rfl⟩ := VOf.exists_eq_inv_smul_cls v
      rw [map_smul, smul_mul_assoc]
      refine Submodule.smul_mem _ _ ?_
      have key : Submodule.span ℚ (toMilnorKQ L '' grade L i) ≤
          (Submodule.span ℚ (toMilnorKQ L '' grade L (i + 1))).comap
            (LinearMap.mulLeft ℚ (MilnorKQ.ι ⊥ (cls ⊥ (.ofMul a)))) := by
        rw [Submodule.span_le]
        rintro _ ⟨y, hy, rfl⟩
        refine Submodule.subset_span ⟨ι L (.ofMul a) * y, ?_, ?_⟩
        · rw [grade, pow_succ']
          exact Submodule.mul_mem_mul (LinearMap.mem_range_self _ _) hy
        · rw [map_mul, toMilnorKQ_ι]
          rfl
      exact key hx
  · rintro _ ⟨x, hx, rfl⟩
    exact toMilnorKQ_mem_grade hx

/-- The comparison isomorphism is compatible with `r^deg`: if `x ∈ K^M_n(L)`, then
`r^deg (q ⊗ x) = (r ^ n q) ⊗ x`. -/
theorem degScale_ratEquiv_tmul (r q : ℚ) {n : ℕ} {x : MilnorK L} (hx : x ∈ grade L n) :
    MilnorKQ.degScale ⊥ r (ratEquiv L (q ⊗ₜ x)) = ratEquiv L ((r ^ n * q) ⊗ₜ x) := by
  rw [MilnorKQ.degScale_apply_of_mem_grade r (ratEquiv_tmul_mem_grade q hx), ratEquiv_tmul,
    ratEquiv_tmul, mul_smul]

end Grading

end MilnorK

/-! ### Quotients by two-sided ideals -/

-- TODO(move): a general fact about `RingQuot`.
/-- If `f : RingQuot r → B` is injective, the kernel of `A → RingQuot r → B` is the two-sided
ideal generated by the differences `x - y` with `r x y`. -/
theorem ker_comp_mkRingHom_eq_span {A B : Type*} [Ring A] [Ring B] {r : A → A → Prop}
    (f : RingQuot r →+* B) (hf : Function.Injective f) :
    TwoSidedIdeal.ker (f.comp (RingQuot.mkRingHom r)) =
      TwoSidedIdeal.span {z | ∃ x y, r x y ∧ x - y = z} := by
  set I := TwoSidedIdeal.span {z | ∃ x y, r x y ∧ x - y = z}
  refine le_antisymm (fun x hx ↦ ?_) (TwoSidedIdeal.span_le.2 ?_)
  · have hq : ∀ ⦃a b : A⦄, r a b → I.ringCon.mk' a = I.ringCon.mk' b := fun a b hab ↦
      Quotient.sound' ((I.rel_iff a b).2 (TwoSidedIdeal.subset_span ⟨a, b, hab, rfl⟩))
    have h₁ : RingQuot.mkRingHom r x = 0 :=
      hf (by rw [map_zero, ← RingHom.comp_apply]; exact (TwoSidedIdeal.mem_ker _).1 hx)
    have h₂ := congrArg (RingQuot.lift ⟨I.ringCon.mk', hq⟩) h₁
    rw [RingQuot.lift_mkRingHom_apply, map_zero] at h₂
    rw [← TwoSidedIdeal.ker_ringCon_mk' I, TwoSidedIdeal.mem_ker]
    exact h₂
  · rintro _ ⟨a, b, hab, rfl⟩
    rw [SetLike.mem_coe, TwoSidedIdeal.mem_ker, map_sub, RingHom.comp_apply, RingHom.comp_apply,
      RingQuot.mkRingHom_rel hab, sub_self]

/-! ### The relative comparison `𝒦_*(L|l) ≅ 𝒦_*(L) / ⟨l^×⟩` -/

-- TODO(move): this belongs in `MilnorAlgDep/Foundations/VOf.lean`.
/-- The projection `VOf H → VOf H'` is surjective. -/
theorem VOf.proj_surjective {H H' : Subgroup Lˣ} (h : H ≤ H') :
    Function.Surjective (VOf.proj h) := fun v ↦ by
  obtain ⟨n, a, -, rfl⟩ := VOf.exists_eq_inv_smul_cls v
  exact ⟨(n : ℚ)⁻¹ • cls H (.ofMul a), by rw [map_smul, proj_cls]⟩

namespace MilnorKQ

variable (H H' : Subgroup Lˣ) in
/-- The relation `ι [c] ~ 0` for `c ∈ H'` on `MilnorKQ H`. The quotient `RingQuot (ConstRel H H')`
is the quotient of `MilnorKQ H` by the two-sided ideal generated by the `ι [c]`, `c ∈ H'`. -/
inductive ConstRel : MilnorKQ H → MilnorKQ H → Prop
  | mk (c : Lˣ) (hc : c ∈ H') : ConstRel (ι H (cls H (.ofMul c))) 0

variable {H H' : Subgroup Lˣ}

/-- The algebra homomorphism `MilnorKQ H / ⟨ι [c] | c ∈ H'⟩ → MilnorKQ H'` induced by
`proj : MilnorKQ H → MilnorKQ H'`. -/
noncomputable def quotToMilnorKQ (h : H ≤ H') : RingQuot (ConstRel H H') →ₐ[ℚ] MilnorKQ H' :=
  RingQuot.liftAlgHom ℚ ⟨proj h, fun _ _ r ↦ by
    cases r with
    | mk c hc => rw [proj_ι, proj_cls, cls_eq_zero_of_mem hc, map_zero, map_zero]⟩

theorem quotToMilnorKQ_mk (h : H ≤ H') (x : MilnorKQ H) :
    quotToMilnorKQ h (RingQuot.mkAlgHom ℚ (ConstRel H H') x) = proj h x :=
  RingQuot.liftAlgHom_mkAlgHom_apply ℚ _ _ x

variable (H) in
/-- The `ℚ`-linear map `VOf H' → MilnorKQ H / ⟨ι [c] | c ∈ H'⟩`, `[a] ↦ ι [a]`. -/
noncomputable def ofVOfQuot : VOf H' →ₗ[ℚ] RingQuot (ConstRel H H') :=
  VOf.lift (((RingQuot.mkAlgHom ℚ (ConstRel H H')).toLinearMap ∘ₗ ι H).toAddMonoidHom.comp
    (cls H)) fun c hc ↦ (RingQuot.mkAlgHom_rel ℚ (ConstRel.mk c hc)).trans (map_zero _)

theorem ofVOfQuot_cls (a : Lˣ) :
    ofVOfQuot H (cls H' (.ofMul a)) =
      RingQuot.mkAlgHom ℚ (ConstRel H H') (ι H (cls H (.ofMul a))) :=
  VOf.lift_cls _ _ a

variable (H H') in
/-- The algebra homomorphism `MilnorKQ H' → MilnorKQ H / ⟨ι [c] | c ∈ H'⟩`, `ι [a] ↦ ι [a]`. -/
noncomputable def ofMilnorKQQuot : MilnorKQ H' →ₐ[ℚ] RingQuot (ConstRel H H') :=
  lift (ofVOfQuot H) fun a b hab ↦ by
    rw [ofVOfQuot_cls, ofVOfQuot_cls, ← map_mul, ι_mul_ι_eq_zero H hab, map_zero]

theorem ofMilnorKQQuot_ι_cls (a : Lˣ) :
    ofMilnorKQQuot H H' (ι H' (cls H' (.ofMul a))) =
      RingQuot.mkAlgHom ℚ (ConstRel H H') (ι H (cls H (.ofMul a))) := by
  rw [ofMilnorKQQuot, lift_ι, ofVOfQuot_cls]

/-- **Comparison with the paper's `𝒦_*(L|l)` (general form).** For subgroups `H ≤ H'` of `Lˣ`,
`MilnorKQ H'` is the quotient of `MilnorKQ H` by the two-sided ideal generated by the elements
`ι [c]`, `c ∈ H'`: the isomorphism `RingQuot (ConstRel H H') ≃ₐ[ℚ] MilnorKQ H'` is induced by
`proj` (`quotEquiv_mk`) and sends the class of `ι [a]` to `ι [a]`.

Here the quotient by the two-sided ideal is `RingQuot` of the relation `ι [c] ~ 0`, `c ∈ H'`; see
`ker_proj` for the formulation with `TwoSidedIdeal.span`. -/
noncomputable def quotEquiv (h : H ≤ H') : RingQuot (ConstRel H H') ≃ₐ[ℚ] MilnorKQ H' :=
  AlgEquiv.ofAlgHom (quotToMilnorKQ h) (ofMilnorKQQuot H H')
    (algHom_ext <| VOf.linearMap_ext fun a ↦ by
      simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply,
        AlgHom.id_apply]
      rw [ofMilnorKQQuot_ι_cls, quotToMilnorKQ_mk, proj_ι, proj_cls])
    (RingQuot.ringQuot_ext' ℚ _ _ <| algHom_ext <| VOf.linearMap_ext fun a ↦ by
      simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply,
        AlgHom.id_apply]
      rw [quotToMilnorKQ_mk, proj_ι, proj_cls, ofMilnorKQQuot_ι_cls])

@[simp]
theorem quotEquiv_mk (h : H ≤ H') (x : MilnorKQ H) :
    quotEquiv h (RingQuot.mkAlgHom ℚ (ConstRel H H') x) = proj h x :=
  quotToMilnorKQ_mk h x

/-- The isomorphism `quotEquiv` in degree one: the class of `ι v` maps to `ι (proj v)`. -/
theorem quotEquiv_mk_ι (h : H ≤ H') (v : VOf H) :
    quotEquiv h (RingQuot.mkAlgHom ℚ (ConstRel H H') (ι H v)) = ι H' (VOf.proj h v) := by
  rw [quotEquiv_mk, proj_ι]

@[simp]
theorem quotEquiv_symm_ι_cls (h : H ≤ H') (a : Lˣ) :
    (quotEquiv h).symm (ι H' (cls H' (.ofMul a))) =
      RingQuot.mkAlgHom ℚ (ConstRel H H') (ι H (cls H (.ofMul a))) := by
  rw [AlgEquiv.symm_apply_eq, quotEquiv_mk_ι, proj_cls]

theorem proj_eq_quotEquiv_comp (h : H ≤ H') :
    proj h = (quotEquiv h).toAlgHom.comp (RingQuot.mkAlgHom ℚ (ConstRel H H')) :=
  AlgHom.ext fun x ↦ (quotEquiv_mk h x).symm

/-- The projection `MilnorKQ H → MilnorKQ H'` is surjective. -/
theorem proj_surjective (h : H ≤ H') : Function.Surjective (proj h) := by
  rw [proj_eq_quotEquiv_comp]
  exact (quotEquiv h).surjective.comp (RingQuot.mkAlgHom_surjective ℚ _)

/-- **The kernel of the projection.** For subgroups `H ≤ H'` of `Lˣ`, the kernel of
`proj : MilnorKQ H → MilnorKQ H'` is the two-sided ideal generated by the `ι [c]`, `c ∈ H'`. -/
theorem ker_proj (h : H ≤ H') :
    TwoSidedIdeal.ker (proj h) =
      TwoSidedIdeal.span {x | ∃ c ∈ H', ι H (cls H (.ofMul c)) = x} := by
  have hker : TwoSidedIdeal.ker (proj h) = TwoSidedIdeal.ker
      (((quotEquiv h).toRingEquiv.toRingHom).comp (RingQuot.mkRingHom (ConstRel H H'))) :=
    TwoSidedIdeal.ext fun x ↦ by
      rw [TwoSidedIdeal.mem_ker, TwoSidedIdeal.mem_ker, ← quotEquiv_mk, RingHom.comp_apply,
        ← RingQuot.mkAlgHom_coe ℚ]
      rfl
  rw [hker, ker_comp_mkRingHom_eq_span (quotEquiv h).toRingEquiv.toRingHom (quotEquiv h).injective]
  congr 1
  ext z
  constructor
  · rintro ⟨x, y, ⟨c, hc⟩, rfl⟩
    exact ⟨c, hc, (sub_zero _).symm⟩
  · rintro ⟨c, hc, rfl⟩
    exact ⟨_, _, ConstRel.mk c hc, sub_zero _⟩

/-- `proj x = 0` if and only if `x` lies in the two-sided ideal generated by the `ι [c]`,
`c ∈ H'`. -/
theorem proj_eq_zero_iff (h : H ≤ H') {x : MilnorKQ H} :
    proj h x = 0 ↔ x ∈ TwoSidedIdeal.span {x | ∃ c ∈ H', ι H (cls H (.ofMul c)) = x} := by
  rw [← ker_proj h, TwoSidedIdeal.mem_ker]

/-- The grading of `MilnorKQ H'` is the image of the grading of `MilnorKQ H`. -/
theorem grade_eq_map_proj (h : H ≤ H') (n : ℕ) :
    grade H' n = (grade H n).map (proj h).toLinearMap := by
  have h₁ : (LinearMap.range (ι H)).map (proj h).toLinearMap = LinearMap.range (ι H') := by
    rw [← LinearMap.range_comp, show (proj h).toLinearMap ∘ₗ ι H = ι H' ∘ₗ VOf.proj h from
      LinearMap.ext (proj_ι h), LinearMap.range_comp,
      LinearMap.range_eq_top.2 (VOf.proj_surjective h), Submodule.map_top]
  rw [grade, grade, Submodule.map_pow, h₁]

section Relative

variable (l L : Type*) [Field l] [Field L] [Algebra l L]

/-- **Comparison with the paper's `𝒦_*(L|l) = 𝒦_*(L) / ⟨l^×⟩`.** `MilnorKQ (constUnits l L)` is
the quotient of `MilnorKQ ⊥ = 𝒦_*(L)` by the two-sided ideal generated by the elements `ι [c]`,
`c ∈ lˣ` (the image of `lˣ ⊆ 𝒦_1(L)`). This is `quotEquiv` for `⊥ ≤ constUnits l L`. -/
noncomputable def relQuotEquiv :
    RingQuot (ConstRel ⊥ (constUnits l L)) ≃ₐ[ℚ] MilnorKQ (constUnits l L) :=
  quotEquiv bot_le

end Relative

end MilnorKQ

/-! ### The relative comparison in terms of `ℚ ⊗ K^M_*(L)` -/

namespace MilnorK

variable (H) in
/-- The relation `1 ⊗ ι c ~ 0` for `c ∈ H` on `ℚ ⊗[ℤ] K^M_*(L)`. The quotient
`RingQuot (ConstRel H)` is the quotient of `ℚ ⊗[ℤ] K^M_*(L)` by the two-sided ideal generated by
the `1 ⊗ ι c`, `c ∈ H`. -/
inductive ConstRel (H : Subgroup Lˣ) : ℚ ⊗[ℤ] MilnorK L → ℚ ⊗[ℤ] MilnorK L → Prop
  | mk (c : Lˣ) (hc : c ∈ H) : ConstRel H ((1 : ℚ) ⊗ₜ ι L (.ofMul c)) 0

variable {H : Subgroup Lˣ}

variable (H) in
/-- The algebra homomorphism `(ℚ ⊗[ℤ] K^M_*(L)) / ⟨1 ⊗ ι c | c ∈ H⟩ → MilnorKQ H` induced by
`proj ∘ ratEquiv`. -/
noncomputable def quotToMilnorKQ : RingQuot (ConstRel H) →ₐ[ℚ] MilnorKQ H :=
  RingQuot.liftAlgHom ℚ ⟨(MilnorKQ.proj bot_le).comp (ratEquiv L).toAlgHom, fun _ _ r ↦ by
    cases r with
    | mk c hc =>
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, ratEquiv_one_tmul_ι, MilnorKQ.proj_ι,
        proj_cls, cls_eq_zero_of_mem hc, map_zero]⟩

theorem quotToMilnorKQ_mk (x : ℚ ⊗[ℤ] MilnorK L) :
    quotToMilnorKQ H (RingQuot.mkAlgHom ℚ (ConstRel H) x) = MilnorKQ.proj bot_le (ratEquiv L x) :=
  RingQuot.liftAlgHom_mkAlgHom_apply ℚ _ _ x

variable (H) in
/-- The `ℚ`-linear map `VOf H → (ℚ ⊗[ℤ] K^M_*(L)) / ⟨1 ⊗ ι c | c ∈ H⟩`, `[a] ↦ 1 ⊗ ι a`. -/
noncomputable def ofVOfQuot : VOf H →ₗ[ℚ] RingQuot (ConstRel H) :=
  VOf.lift ((RingQuot.mkAlgHom ℚ (ConstRel H)).toLinearMap.toAddMonoidHom.comp
    ((TensorProduct.mk ℤ ℚ (MilnorK L) 1).toAddMonoidHom.comp (ι L))) fun c hc ↦
    (RingQuot.mkAlgHom_rel ℚ (ConstRel.mk c hc)).trans (map_zero _)

theorem ofVOfQuot_cls (a : Lˣ) :
    ofVOfQuot H (cls H (.ofMul a)) = RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ ι L (.ofMul a)) :=
  VOf.lift_cls _ _ a

variable (H) in
/-- The algebra homomorphism `MilnorKQ H → (ℚ ⊗[ℤ] K^M_*(L)) / ⟨1 ⊗ ι c | c ∈ H⟩`,
`ι [a] ↦ 1 ⊗ ι a`. -/
noncomputable def ofMilnorKQQuot : MilnorKQ H →ₐ[ℚ] RingQuot (ConstRel H) :=
  MilnorKQ.lift (ofVOfQuot H) fun a b hab ↦ by
    rw [ofVOfQuot_cls, ofVOfQuot_cls, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
      ι_mul_ι_eq_zero L hab, tmul_zero, map_zero]

theorem ofMilnorKQQuot_ι_cls (a : Lˣ) :
    ofMilnorKQQuot H (MilnorKQ.ι H (cls H (.ofMul a))) =
      RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ ι L (.ofMul a)) := by
  rw [ofMilnorKQQuot, MilnorKQ.lift_ι, ofVOfQuot_cls]

variable (H) in
/-- **Comparison with the paper's `𝒦_*(L|l) = (ℚ ⊗ K^M_*(L)) / ⟨l^×⟩`.** For a subgroup `H ≤ Lˣ`,
`MilnorKQ H` is the quotient of `ℚ ⊗[ℤ] K^M_*(L)` by the two-sided ideal generated by the
elements `1 ⊗ ι c`, `c ∈ H`: the isomorphism `RingQuot (ConstRel H) ≃ₐ[ℚ] MilnorKQ H` is induced by
`proj ∘ ratEquiv` (`quotEquiv_mk`) and sends the class of `1 ⊗ ι a` to `ι [a]`
(`quotEquiv_mk_one_tmul_ι`). For `H = constUnits l L` this is the paper's
`𝒦_*(L|l) = 𝒦_*(L) / ⟨l^×⟩`, with `𝒦_*(L) = ℚ ⊗ K^M_*(L)`.

Here the quotient by the two-sided ideal is `RingQuot` of the relation `1 ⊗ ι c ~ 0`, `c ∈ H`;
see `ker_proj_comp_ratEquiv` for the formulation with `TwoSidedIdeal.span`. -/
noncomputable def quotEquiv : RingQuot (ConstRel H) ≃ₐ[ℚ] MilnorKQ H :=
  AlgEquiv.ofAlgHom (quotToMilnorKQ H) (ofMilnorKQQuot H)
    (MilnorKQ.algHom_ext <| VOf.linearMap_ext fun a ↦ by
      simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply,
        AlgHom.id_apply]
      rw [ofMilnorKQQuot_ι_cls, quotToMilnorKQ_mk, ratEquiv_one_tmul_ι, MilnorKQ.proj_ι, proj_cls])
    (RingQuot.ringQuot_ext' ℚ _ _ <| ratAlgHom_ext fun a ↦ by
      simp only [AlgHom.comp_apply, AlgHom.id_apply]
      rw [quotToMilnorKQ_mk, ratEquiv_one_tmul_ι, MilnorKQ.proj_ι, proj_cls, ofMilnorKQQuot_ι_cls])

@[simp]
theorem quotEquiv_mk (x : ℚ ⊗[ℤ] MilnorK L) :
    quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) x) = MilnorKQ.proj bot_le (ratEquiv L x) :=
  quotToMilnorKQ_mk x

/-- The isomorphism `quotEquiv` in degree one: the class of `1 ⊗ ι a` maps to `ι [a]`. -/
theorem quotEquiv_mk_one_tmul_ι (a : Lˣ) :
    quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ ι L (.ofMul a))) =
      MilnorKQ.ι H (cls H (.ofMul a)) := by
  rw [quotEquiv_mk, ratEquiv_one_tmul_ι, MilnorKQ.proj_ι, proj_cls]

/-- The isomorphism `quotEquiv` on symbols: the class of `1 ⊗ {a, b}` maps to `{a, b}`. -/
theorem quotEquiv_mk_one_tmul_symbol (a b : Lˣ) :
    quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ symbol L a b)) =
      MilnorKQ.symbol H a b := by
  rw [quotEquiv_mk, ratEquiv_one_tmul_symbol, MilnorKQ.proj_symbol]

@[simp]
theorem quotEquiv_symm_ι_cls (a : Lˣ) :
    (quotEquiv H).symm (MilnorKQ.ι H (cls H (.ofMul a))) =
      RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ ι L (.ofMul a)) := by
  rw [AlgEquiv.symm_apply_eq, quotEquiv_mk_one_tmul_ι]

/-- **The kernel of `ℚ ⊗ K^M_*(L) → MilnorKQ H`.** The kernel of `proj ∘ ratEquiv` is the
two-sided ideal generated by the `1 ⊗ ι c`, `c ∈ H`. -/
theorem ker_proj_comp_ratEquiv :
    TwoSidedIdeal.ker ((MilnorKQ.proj (bot_le : ⊥ ≤ H)).comp (ratEquiv L).toAlgHom) =
      TwoSidedIdeal.span {x | ∃ c ∈ H, (1 : ℚ) ⊗ₜ ι L (.ofMul c) = x} := by
  have hker : TwoSidedIdeal.ker ((MilnorKQ.proj (bot_le : ⊥ ≤ H)).comp (ratEquiv L).toAlgHom) =
      TwoSidedIdeal.ker
        (((quotEquiv H).toRingEquiv.toRingHom).comp (RingQuot.mkRingHom (ConstRel H))) :=
    TwoSidedIdeal.ext fun x ↦ by
      rw [TwoSidedIdeal.mem_ker, TwoSidedIdeal.mem_ker, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
        ← quotEquiv_mk, RingHom.comp_apply, ← RingQuot.mkAlgHom_coe ℚ]
      rfl
  rw [hker, ker_comp_mkRingHom_eq_span (quotEquiv H).toRingEquiv.toRingHom (quotEquiv H).injective]
  congr 1
  ext z
  constructor
  · rintro ⟨x, y, ⟨c, hc⟩, rfl⟩
    exact ⟨c, hc, (sub_zero _).symm⟩
  · rintro ⟨c, hc, rfl⟩
    exact ⟨_, _, ConstRel.mk c hc, sub_zero _⟩

/-- The relative comparison is compatible with the maps induced by a ring homomorphism
`τ : K →+* L` with `τ(H₀) ⊆ H`: `τ_*` on `MilnorKQ` corresponds to `id_ℚ ⊗ τ_*`. -/
theorem quotEquiv_mk_ratMap (τ : K →+* L) {H₀ : Subgroup Kˣ}
    (h : H₀ ≤ H.comap (Units.map (τ : K →* L))) (x : ℚ ⊗[ℤ] MilnorK K) :
    quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) (ratMap τ x)) =
      MilnorKQ.map τ h (quotEquiv H₀ (RingQuot.mkAlgHom ℚ (ConstRel H₀) x)) := by
  have key : (MilnorKQ.proj (bot_le : ⊥ ≤ H)).comp (MilnorKQ.map τ bot_le) =
      (MilnorKQ.map τ h).comp (MilnorKQ.proj (bot_le : ⊥ ≤ H₀)) :=
    MilnorKQ.algHom_ext <| VOf.linearMap_ext fun a ↦ by
      simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply,
        MilnorKQ.map_ι, MilnorKQ.proj_ι, mapRingHom_cls, proj_cls]
  rw [quotEquiv_mk, quotEquiv_mk, ratEquiv_ratMap, ← AlgHom.comp_apply, key, AlgHom.comp_apply]

/-- The relative comparison is graded: it maps the class of `q ⊗ x`, `x ∈ K^M_n(L)`, into
`MilnorKQ.grade H n`. -/
theorem quotEquiv_mk_tmul_mem_grade (q : ℚ) {n : ℕ} {x : MilnorK L} (hx : x ∈ grade L n) :
    quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) (q ⊗ₜ x)) ∈ MilnorKQ.grade H n := by
  rw [quotEquiv_mk]
  exact MilnorKQ.isGraded_proj bot_le n (Submodule.mem_map_of_mem (ratEquiv_tmul_mem_grade q hx))

variable (H) in
/-- The relative comparison is graded: `MilnorKQ.grade H n` is the `ℚ`-span of the image of the
classes of `1 ⊗ K^M_n(L)`. -/
theorem grade_eq_span (n : ℕ) :
    MilnorKQ.grade H n = Submodule.span ℚ
      ((fun x ↦ quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ x))) '' grade L n) := by
  rw [MilnorKQ.grade_eq_map_proj (bot_le : ⊥ ≤ H), grade_bot_eq_span, Submodule.map_span,
    Set.image_image]
  simp only [quotEquiv_mk]
  rfl

/-- The relative comparison is compatible with `r^deg`: if `x ∈ K^M_n(L)`, then `r^deg` maps the
class of `q ⊗ x` to the class of `(r ^ n q) ⊗ x`. -/
theorem degScale_quotEquiv_mk_tmul (r q : ℚ) {n : ℕ} {x : MilnorK L} (hx : x ∈ grade L n) :
    MilnorKQ.degScale H r (quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) (q ⊗ₜ x))) =
      quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) ((r ^ n * q) ⊗ₜ x)) := by
  rw [quotEquiv_mk, quotEquiv_mk, ← degScale_ratEquiv_tmul r q hx, ← AlgHom.comp_apply,
    MilnorKQ.degScale_comp_proj, AlgHom.comp_apply]

end MilnorK

end MilnorAlgDep
