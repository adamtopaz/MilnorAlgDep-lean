module

public import Mathlib.Algebra.RingQuot
public import Mathlib.LinearAlgebra.TensorAlgebra.Basic
public import Mathlib.RingTheory.TwoSidedIdeal.Kernel
public import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# The integral Milnor ring `K^M_*(L)`

Blueprint, Section 1.2 (the Milnor ring `K^M_*(K)`).

`MilnorK L` is the Milnor ring of the field `L`, defined exactly as in the paper: the quotient of
the tensor algebra over `ℤ` of the abelian group `Lˣ` (written additively, `Additive Lˣ`) by the
two-sided ideal generated by the Steinberg elements `a ⊗ b` with `a + b = 1`, i.e. `x ⊗ (1 - x)`
for `x ≠ 0, 1` (`MilnorK.symbol_one_sub_eq_zero`). The quotient by the two-sided ideal generated by
a relation is Mathlib's `RingQuot`, as for `MilnorKQ`; `MilnorK.ker_mkRingHom` states the
definition with `TwoSidedIdeal.span` (via the general `ker_comp_mkRingHom_eq_span`).

It is only used to compare the rational Milnor rings `MilnorKQ` of the formalization with the
paper's `𝒦_*(L) = ℚ ⊗ K^M_*(L)`; see `MilnorAlgDep.Milnor.Comparison`.

## Main definitions

* `MilnorK L`, with `MilnorK.ι : Additive Lˣ →+ MilnorK L` and `MilnorK.symbol a b = {a, b}`.
* `MilnorK.lift`: the universal property; `MilnorK.ringHom_ext`, `MilnorK.intAlgHom_ext`.
* `MilnorK.map τ`: the homomorphism `τ_*` induced by a ring homomorphism `τ`.
* `MilnorK.grade L n`: the degree `n` part `K^M_n(L) = (range ι) ^ n`.
-/

@[expose] public section

namespace MilnorAlgDep

variable {K L M : Type*} [Field K] [Field L] [Field M]

/-! ### Quotients by two-sided ideals -/

-- TODO(move): a general fact about `RingQuot`.
/-- If `f : RingQuot r → B` is injective, the kernel of `A → RingQuot r → B` is the two-sided
ideal generated by the differences `x - y` with `r x y`. -/
theorem ker_comp_mkRingHom_eq_span {A B : Type*} [Ring A] [Ring B] {r : A → A → Prop}
    (f : RingQuot r →+* B) (hf : Function.Injective f) :
    TwoSidedIdeal.ker (f.comp (RingQuot.mkRingHom r)) =
      TwoSidedIdeal.span {z | ∃ x y, r x y ∧ x - y = z} := by
  set I := TwoSidedIdeal.span {z | ∃ x y, r x y ∧ x - y = z}
  refine le_antisymm (fun x hx ↦ ?_) (TwoSidedIdeal.span_le.2 ?_)
  · have hq : ∀ ⦃a b : A⦄, r a b → I.ringCon.mk' a = I.ringCon.mk' b := fun a b hab ↦
      Quotient.sound' ((I.rel_iff a b).2 (TwoSidedIdeal.subset_span ⟨a, b, hab, rfl⟩))
    have h₁ : RingQuot.mkRingHom r x = 0 :=
      hf (by rw [map_zero, ← RingHom.comp_apply]; exact (TwoSidedIdeal.mem_ker _).1 hx)
    have h₂ := congrArg (RingQuot.lift ⟨I.ringCon.mk', hq⟩) h₁
    rw [RingQuot.lift_mkRingHom_apply, map_zero] at h₂
    rw [← TwoSidedIdeal.ker_ringCon_mk' I, TwoSidedIdeal.mem_ker]
    exact h₂
  · rintro _ ⟨a, b, hab, rfl⟩
    rw [SetLike.mem_coe, TwoSidedIdeal.mem_ker, map_sub, RingHom.comp_apply, RingHom.comp_apply,
      RingQuot.mkRingHom_rel hab, sub_self]

namespace MilnorK

variable (L) in
/-- The Steinberg relations on the tensor algebra `T_ℤ(Lˣ)` of the abelian group `Lˣ` (written
additively): `ι a * ι b` is related to `0` whenever `a + b = 1` in `L`. -/
inductive SteinbergRel : TensorAlgebra ℤ (Additive Lˣ) → TensorAlgebra ℤ (Additive Lˣ) → Prop
  | mk (a b : Lˣ) (hab : (a : L) + b = 1) :
      SteinbergRel (TensorAlgebra.ι ℤ (.ofMul a) * TensorAlgebra.ι ℤ (.ofMul b)) 0

end MilnorK

/-- Blueprint 1.2: the Milnor ring `K^M_*(L)` of a field `L`: the quotient of the tensor algebra
`T_ℤ(Lˣ)` of the abelian group `Lˣ` (written additively) by the two-sided ideal generated by the
Steinberg elements `a ⊗ b` with `a + b = 1`, i.e. `x ⊗ (1 - x)` for `x ≠ 0, 1`. -/
def MilnorK (L : Type*) [Field L] : Type _ :=
  RingQuot (MilnorK.SteinbergRel L)

namespace MilnorK

/-- `MilnorK L` is a ring. (We do not transfer the `ℤ`-algebra structure of `RingQuot`: the
`ℤ`-algebra structure of `MilnorK L` is `Ring.toIntAlgebra`, and ring homomorphisms out of it are
the same as `ℤ`-algebra homomorphisms.) -/
noncomputable instance : Ring (MilnorK L) :=
  inferInstanceAs (Ring (RingQuot (SteinbergRel L)))

variable (L)

/-- The quotient map `T_ℤ(Lˣ) → K^M_*(L)`. -/
noncomputable def mkRingHom : TensorAlgebra ℤ (Additive Lˣ) →+* MilnorK L :=
  RingQuot.mkRingHom (SteinbergRel L)

/-- The inclusion of degree one, `Lˣ → K^M_1(L)`, `a ↦ {a}`. -/
noncomputable def ι : Additive Lˣ →+ MilnorK L :=
  (mkRingHom L).toAddMonoidHom.comp (TensorAlgebra.ι ℤ).toAddMonoidHom

/-- The symbol `{a, b} = ι a * ι b ∈ K^M_2(L)`. -/
noncomputable def symbol (a b : Lˣ) : MilnorK L :=
  ι L (.ofMul a) * ι L (.ofMul b)

theorem ι_apply (a : Additive Lˣ) : ι L a = mkRingHom L (TensorAlgebra.ι ℤ a) :=
  rfl

/-- `MilnorK L` is the quotient of `T_ℤ(Lˣ)` by the two-sided ideal generated by the Steinberg
elements `a ⊗ b`, `a + b = 1` (the formulation of the paper, with `TwoSidedIdeal.span`). -/
theorem ker_mkRingHom : TwoSidedIdeal.ker (mkRingHom L) = TwoSidedIdeal.span
    {t | ∃ a b : Lˣ, (a : L) + b = 1 ∧
      TensorAlgebra.ι ℤ (.ofMul a) * TensorAlgebra.ι ℤ (.ofMul b) = t} := by
  have h := ker_comp_mkRingHom_eq_span (RingHom.id (RingQuot (SteinbergRel L)))
    Function.injective_id
  rw [RingHom.id_comp] at h
  refine h.trans ?_
  congr 1
  ext t
  constructor
  · rintro ⟨x, y, ⟨a, b, hab⟩, rfl⟩
    exact ⟨a, b, hab, (sub_zero _).symm⟩
  · rintro ⟨a, b, hab, rfl⟩
    exact ⟨_, _, SteinbergRel.mk a b hab, sub_zero _⟩

/-- The Steinberg relation: `ι a * ι b = 0` if `a + b = 1`. -/
theorem ι_mul_ι_eq_zero {a b : Lˣ} (hab : (a : L) + b = 1) :
    ι L (.ofMul a) * ι L (.ofMul b) = 0 := by
  have h := RingQuot.mkRingHom_rel (SteinbergRel.mk a b hab)
  rw [map_mul, map_zero] at h
  exact h

/-- The Steinberg relation: `{a, b} = 0` if `a + b = 1`. -/
theorem symbol_eq_zero {a b : Lˣ} (hab : (a : L) + b = 1) : symbol L a b = 0 :=
  ι_mul_ι_eq_zero L hab

/-- The Steinberg relation in the paper's form: `{x, 1 - x} = 0` for `x ≠ 0, 1`. (Conversely,
if `a + b = 1` for units `a, b`, then `b = 1 - a` and `a ≠ 1`, so the relations `ι a * ι b ~ 0`,
`a + b = 1`, defining `MilnorK L` are exactly the paper's relations `x ⊗ (1 - x)`, `x ≠ 0, 1`.) -/
theorem symbol_one_sub_eq_zero {x : L} (hx₀ : x ≠ 0) (hx₁ : x ≠ 1) :
    symbol L (Units.mk0 x hx₀) (Units.mk0 (1 - x) (sub_ne_zero.2 hx₁.symm)) = 0 :=
  symbol_eq_zero L (by simp)

variable {L}

/-- The universal property of `K^M_*(L)`: an additive map `f : Lˣ → A` into a ring with
`f a * f b = 0` whenever `a + b = 1` extends to a ring homomorphism `K^M_*(L) → A`. -/
noncomputable def lift {A : Type*} [Ring A] (f : Additive Lˣ →+ A)
    (hf : ∀ a b : Lˣ, (a : L) + b = 1 → f (.ofMul a) * f (.ofMul b) = 0) : MilnorK L →+* A :=
  RingQuot.lift ⟨(TensorAlgebra.lift ℤ f.toIntLinearMap).toRingHom, fun _ _ h ↦ by
    cases h with
    | mk a b hab =>
      rw [map_mul, map_zero, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
        TensorAlgebra.lift_ι_apply, TensorAlgebra.lift_ι_apply]
      exact hf a b hab⟩

@[simp]
theorem lift_ι {A : Type*} [Ring A] (f : Additive Lˣ →+ A)
    (hf : ∀ a b : Lˣ, (a : L) + b = 1 → f (.ofMul a) * f (.ofMul b) = 0) (a : Additive Lˣ) :
    lift f hf (ι L a) = f a :=
  (RingQuot.lift_mkRingHom_apply (TensorAlgebra.lift ℤ f.toIntLinearMap).toRingHom _
    (TensorAlgebra.ι ℤ a)).trans (TensorAlgebra.lift_ι_apply f.toIntLinearMap a)

/-- Two ring homomorphisms out of `K^M_*(L)` agreeing on all `ι a` are equal. -/
theorem ringHom_ext {A : Type*} [Semiring A] {f g : MilnorK L →+* A}
    (h : ∀ a : Lˣ, f (ι L (.ofMul a)) = g (ι L (.ofMul a))) : f = g := by
  refine RingQuot.ringQuot_ext f g (RingHom.ext fun t ↦ ?_)
  induction t using TensorAlgebra.induction with
  | algebraMap r =>
    exact RingHom.congr_fun (RingHom.ext_int ((f.comp (mkRingHom L)).comp (algebraMap ℤ _))
      ((g.comp (mkRingHom L)).comp (algebraMap ℤ _))) r
  | ι v => exact h (Additive.toMul v)
  | mul a b ha hb => rw [map_mul, map_mul, ha, hb]
  | add a b ha hb => rw [map_add, map_add, ha, hb]

/-- Two `ℤ`-algebra homomorphisms out of `K^M_*(L)` agreeing on all `ι a` are equal. -/
theorem intAlgHom_ext {A : Type*} [Ring A] [Algebra ℤ A] {f g : MilnorK L →ₐ[ℤ] A}
    (h : ∀ a : Lˣ, f (ι L (.ofMul a)) = g (ι L (.ofMul a))) : f = g :=
  AlgHom.toRingHom_injective (ringHom_ext h)

section Functoriality

/-- The homomorphism `τ_* : K^M_*(K) → K^M_*(L)` induced by a ring homomorphism `τ : K →+* L`;
it sends `ι a` to `ι (τ a)`. -/
noncomputable def map (τ : K →+* L) : MilnorK K →+* MilnorK L :=
  lift ((ι L).comp (Units.map (τ : K →* L)).toAdditive) fun a b hab ↦ by
    refine ι_mul_ι_eq_zero L ?_
    change τ a + τ b = 1
    rw [← map_add, hab, map_one]

@[simp]
theorem map_ι (τ : K →+* L) (a : Kˣ) :
    map τ (ι K (.ofMul a)) = ι L (.ofMul (Units.map (τ : K →* L) a)) := by
  rw [map, lift_ι]
  rfl

theorem map_symbol (τ : K →+* L) (a b : Kˣ) :
    map τ (symbol K a b) = symbol L (Units.map (τ : K →* L) a) (Units.map (τ : K →* L) b) := by
  rw [symbol, map_mul, map_ι, map_ι, symbol]

@[simp]
theorem map_id : map (RingHom.id L) = RingHom.id (MilnorK L) :=
  ringHom_ext fun a ↦ by rw [map_ι]; rfl

theorem map_comp (τ : K →+* L) (σ : L →+* M) : (map σ).comp (map τ) = map (σ.comp τ) :=
  ringHom_ext fun a ↦ by
    rw [RingHom.comp_apply, map_ι, map_ι, map_ι]
    rfl

end Functoriality

section Grading

variable (L) in
/-- The degree `n` part `K^M_n(L)` of `K^M_*(L)`: the subgroup generated by the products of `n`
elements of degree one, i.e. `(range ι) ^ n`. -/
noncomputable def grade (n : ℕ) : Submodule ℤ (MilnorK L) :=
  LinearMap.range (ι L).toIntLinearMap ^ n

theorem one_mem_grade_zero : (1 : MilnorK L) ∈ grade L 0 := by
  rw [grade, pow_zero]
  exact Submodule.one_le.1 le_rfl

theorem ι_mem_grade_one (a : Additive Lˣ) : ι L a ∈ grade L 1 := by
  rw [grade, pow_one]
  exact LinearMap.mem_range_self (ι L).toIntLinearMap a

theorem symbol_mem_grade_two (a b : Lˣ) : symbol L a b ∈ grade L 2 := by
  rw [grade, pow_two]
  exact Submodule.mul_mem_mul (LinearMap.mem_range_self _ _) (LinearMap.mem_range_self _ _)

end Grading

end MilnorK

end MilnorAlgDep
