module

public import MilnorAlgDep.Milnor.Comparison.Rational

/-!
# The relative comparison `MilnorKQ H ≅ 𝒦_*(L) / ⟨H⟩`

Blueprint, Section 1.2 (`𝒦_*(K|k)` is the quotient of `𝒦_*(K)` by the ideal generated by
`k^× ⊆ 𝒦_1(K)`).

The formalization defines `𝒦_*(L|l)` directly as `MilnorKQ (constUnits l L)`, the quotient of the
tensor algebra over `ℚ` of `V_{L|l}` by the Steinberg relations. We show that it is the quotient of
`𝒦_*(L)` by the two-sided ideal generated by `lˣ`, in two forms:

* intrinsically, for subgroups `H ≤ H'` of `Lˣ`: `MilnorKQ H'` is the quotient of `MilnorKQ H` by
  the two-sided ideal generated by the `ι [c]`, `c ∈ H'` (`MilnorKQ.quotEquiv`,
  `MilnorKQ.ker_proj`, `MilnorKQ.proj_surjective`); for `H = ⊥`, `H' = constUnits l L` this is
  `MilnorKQ.relQuotEquiv l L`;
* in terms of the paper's `𝒦_*(L) = ℚ ⊗ K^M_*(L)`: for a subgroup `H ≤ Lˣ`, `MilnorKQ H` is the
  quotient of `ℚ ⊗[ℤ] MilnorK L` by the two-sided ideal generated by the `1 ⊗ ι c`, `c ∈ H`
  (`MilnorK.quotEquiv`, `MilnorK.ker_proj_comp_ratEquiv`), compatibly with degree one, symbols,
  the grading, `τ_*` and `r^deg`.

"The quotient by the two-sided ideal generated by `S`" is formalized in two equivalent ways:
as `RingQuot` of the relation `s ~ 0`, `s ∈ S` (the definitions `*.quotEquiv`), and as the
statement that the kernel of the canonical map is `TwoSidedIdeal.span S` (the theorems `ker_*`).
The link between the two is `ker_comp_mkRingHom_eq_span` (in `Comparison/Integral.lean`); for
the definition of `MilnorKQ` itself see `MilnorKQ.ker_mkAlgHom`.
-/

@[expose] public section

namespace MilnorAlgDep

open VOf TensorProduct

variable {K L : Type*} [Field K] [Field L]

namespace MilnorKQ

/-- `MilnorKQ H` is the quotient of `T_ℚ(VOf H)` by the two-sided ideal generated by the
Steinberg elements `ι [a] * ι [b]`, `a + b = 1`. -/
theorem ker_mkAlgHom (H : Subgroup Lˣ) :
    TwoSidedIdeal.ker (mkAlgHom H) = TwoSidedIdeal.span {t | ∃ a b : Lˣ, (a : L) + b = 1 ∧
      TensorAlgebra.ι ℚ (cls H (.ofMul a)) * TensorAlgebra.ι ℚ (cls H (.ofMul b)) = t} := by
  have h := ker_comp_mkRingHom_eq_span (RingHom.id (RingQuot (SteinbergRel H)))
    Function.injective_id
  rw [RingHom.id_comp] at h
  refine (TwoSidedIdeal.ext fun x ↦ ?_).trans (h.trans ?_)
  · rw [TwoSidedIdeal.mem_ker, TwoSidedIdeal.mem_ker, mkAlgHom, ← RingQuot.mkAlgHom_coe ℚ]
    rfl
  · congr 1
    ext t
    constructor
    · rintro ⟨x, y, ⟨a, b, hab⟩, rfl⟩
      exact ⟨a, b, hab, (sub_zero _).symm⟩
    · rintro ⟨a, b, hab, rfl⟩
      exact ⟨_, _, SteinbergRel.mk a b hab, sub_zero _⟩

end MilnorKQ

/-! ### The relative comparison `𝒦_*(L|l) ≅ 𝒦_*(L) / ⟨l^×⟩` -/

namespace MilnorKQ

variable (H H' : Subgroup Lˣ) in
/-- The relation `ι [c] ~ 0` for `c ∈ H'` on `MilnorKQ H`. The quotient `RingQuot (ConstRel H H')`
is the quotient of `MilnorKQ H` by the two-sided ideal generated by the `ι [c]`, `c ∈ H'`. -/
inductive ConstRel : MilnorKQ H → MilnorKQ H → Prop
  | mk (c : Lˣ) (hc : c ∈ H') : ConstRel (ι H (cls H (.ofMul c))) 0

variable {H H' : Subgroup Lˣ}

/-- The algebra homomorphism `MilnorKQ H / ⟨ι [c] | c ∈ H'⟩ → MilnorKQ H'` induced by
`proj : MilnorKQ H → MilnorKQ H'`. -/
noncomputable def quotToMilnorKQ (h : H ≤ H') : RingQuot (ConstRel H H') →ₐ[ℚ] MilnorKQ H' :=
  RingQuot.liftAlgHom ℚ ⟨proj h, fun _ _ r ↦ by
    cases r with
    | mk c hc => rw [proj_ι, proj_cls, cls_eq_zero_of_mem hc, map_zero, map_zero]⟩

theorem quotToMilnorKQ_mk (h : H ≤ H') (x : MilnorKQ H) :
    quotToMilnorKQ h (RingQuot.mkAlgHom ℚ (ConstRel H H') x) = proj h x :=
  RingQuot.liftAlgHom_mkAlgHom_apply ℚ _ _ x

variable (H) in
/-- The `ℚ`-linear map `VOf H' → MilnorKQ H / ⟨ι [c] | c ∈ H'⟩`, `[a] ↦ ι [a]`. -/
noncomputable def ofVOfQuot : VOf H' →ₗ[ℚ] RingQuot (ConstRel H H') :=
  VOf.lift (((RingQuot.mkAlgHom ℚ (ConstRel H H')).toLinearMap ∘ₗ ι H).toAddMonoidHom.comp
    (cls H)) fun c hc ↦ (RingQuot.mkAlgHom_rel ℚ (ConstRel.mk c hc)).trans (map_zero _)

theorem ofVOfQuot_cls (a : Lˣ) :
    ofVOfQuot H (cls H' (.ofMul a)) =
      RingQuot.mkAlgHom ℚ (ConstRel H H') (ι H (cls H (.ofMul a))) :=
  VOf.lift_cls _ _ a

variable (H H') in
/-- The algebra homomorphism `MilnorKQ H' → MilnorKQ H / ⟨ι [c] | c ∈ H'⟩`, `ι [a] ↦ ι [a]`. -/
noncomputable def ofMilnorKQQuot : MilnorKQ H' →ₐ[ℚ] RingQuot (ConstRel H H') :=
  lift (ofVOfQuot H) fun a b hab ↦ by
    rw [ofVOfQuot_cls, ofVOfQuot_cls, ← map_mul, ι_mul_ι_eq_zero H hab, map_zero]

theorem ofMilnorKQQuot_ι_cls (a : Lˣ) :
    ofMilnorKQQuot H H' (ι H' (cls H' (.ofMul a))) =
      RingQuot.mkAlgHom ℚ (ConstRel H H') (ι H (cls H (.ofMul a))) := by
  rw [ofMilnorKQQuot, lift_ι, ofVOfQuot_cls]

/-- **Comparison with the paper's `𝒦_*(L|l)` (general form).** For subgroups `H ≤ H'` of `Lˣ`,
`MilnorKQ H'` is the quotient of `MilnorKQ H` by the two-sided ideal generated by the elements
`ι [c]`, `c ∈ H'`: the isomorphism `RingQuot (ConstRel H H') ≃ₐ[ℚ] MilnorKQ H'` is induced by
`proj` (`quotEquiv_mk`) and sends the class of `ι [a]` to `ι [a]`.

Here the quotient by the two-sided ideal is `RingQuot` of the relation `ι [c] ~ 0`, `c ∈ H'`; see
`ker_proj` for the formulation with `TwoSidedIdeal.span`. -/
noncomputable def quotEquiv (h : H ≤ H') : RingQuot (ConstRel H H') ≃ₐ[ℚ] MilnorKQ H' :=
  AlgEquiv.ofAlgHom (quotToMilnorKQ h) (ofMilnorKQQuot H H')
    (algHom_ext <| VOf.linearMap_ext fun a ↦ by
      simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply,
        AlgHom.id_apply]
      rw [ofMilnorKQQuot_ι_cls, quotToMilnorKQ_mk, proj_ι, proj_cls])
    (RingQuot.ringQuot_ext' ℚ _ _ <| algHom_ext <| VOf.linearMap_ext fun a ↦ by
      simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply,
        AlgHom.id_apply]
      rw [quotToMilnorKQ_mk, proj_ι, proj_cls, ofMilnorKQQuot_ι_cls])

@[simp]
theorem quotEquiv_mk (h : H ≤ H') (x : MilnorKQ H) :
    quotEquiv h (RingQuot.mkAlgHom ℚ (ConstRel H H') x) = proj h x :=
  quotToMilnorKQ_mk h x

/-- The isomorphism `quotEquiv` in degree one: the class of `ι v` maps to `ι (proj v)`. -/
theorem quotEquiv_mk_ι (h : H ≤ H') (v : VOf H) :
    quotEquiv h (RingQuot.mkAlgHom ℚ (ConstRel H H') (ι H v)) = ι H' (VOf.proj h v) := by
  rw [quotEquiv_mk, proj_ι]

@[simp]
theorem quotEquiv_symm_ι_cls (h : H ≤ H') (a : Lˣ) :
    (quotEquiv h).symm (ι H' (cls H' (.ofMul a))) =
      RingQuot.mkAlgHom ℚ (ConstRel H H') (ι H (cls H (.ofMul a))) := by
  rw [AlgEquiv.symm_apply_eq, quotEquiv_mk_ι, proj_cls]

theorem proj_eq_quotEquiv_comp (h : H ≤ H') :
    proj h = (quotEquiv h).toAlgHom.comp (RingQuot.mkAlgHom ℚ (ConstRel H H')) :=
  AlgHom.ext fun x ↦ (quotEquiv_mk h x).symm

/-- The projection `MilnorKQ H → MilnorKQ H'` is surjective. -/
theorem proj_surjective (h : H ≤ H') : Function.Surjective (proj h) := by
  rw [proj_eq_quotEquiv_comp]
  exact (quotEquiv h).surjective.comp (RingQuot.mkAlgHom_surjective ℚ _)

/-- **The kernel of the projection.** For subgroups `H ≤ H'` of `Lˣ`, the kernel of
`proj : MilnorKQ H → MilnorKQ H'` is the two-sided ideal generated by the `ι [c]`, `c ∈ H'`. -/
theorem ker_proj (h : H ≤ H') :
    TwoSidedIdeal.ker (proj h) =
      TwoSidedIdeal.span {x | ∃ c ∈ H', ι H (cls H (.ofMul c)) = x} := by
  have hker : TwoSidedIdeal.ker (proj h) = TwoSidedIdeal.ker
      (((quotEquiv h).toRingEquiv.toRingHom).comp (RingQuot.mkRingHom (ConstRel H H'))) :=
    TwoSidedIdeal.ext fun x ↦ by
      rw [TwoSidedIdeal.mem_ker, TwoSidedIdeal.mem_ker, ← quotEquiv_mk, RingHom.comp_apply,
        ← RingQuot.mkAlgHom_coe ℚ]
      rfl
  rw [hker, ker_comp_mkRingHom_eq_span (quotEquiv h).toRingEquiv.toRingHom (quotEquiv h).injective]
  congr 1
  ext z
  constructor
  · rintro ⟨x, y, ⟨c, hc⟩, rfl⟩
    exact ⟨c, hc, (sub_zero _).symm⟩
  · rintro ⟨c, hc, rfl⟩
    exact ⟨_, _, ConstRel.mk c hc, sub_zero _⟩

/-- `proj x = 0` if and only if `x` lies in the two-sided ideal generated by the `ι [c]`,
`c ∈ H'`. -/
theorem proj_eq_zero_iff (h : H ≤ H') {x : MilnorKQ H} :
    proj h x = 0 ↔ x ∈ TwoSidedIdeal.span {x | ∃ c ∈ H', ι H (cls H (.ofMul c)) = x} := by
  rw [← ker_proj h, TwoSidedIdeal.mem_ker]

/-- The grading of `MilnorKQ H'` is the image of the grading of `MilnorKQ H`. -/
theorem grade_eq_map_proj (h : H ≤ H') (n : ℕ) :
    grade H' n = (grade H n).map (proj h).toLinearMap := by
  have h₁ : (LinearMap.range (ι H)).map (proj h).toLinearMap = LinearMap.range (ι H') := by
    rw [← LinearMap.range_comp, show (proj h).toLinearMap ∘ₗ ι H = ι H' ∘ₗ VOf.proj h from
      LinearMap.ext (proj_ι h), LinearMap.range_comp,
      LinearMap.range_eq_top.2 (VOf.proj_surjective h), Submodule.map_top]
  rw [grade, grade, Submodule.map_pow, h₁]

section Relative

variable (l L : Type*) [Field l] [Field L] [Algebra l L]

/-- **Comparison with the paper's `𝒦_*(L|l) = 𝒦_*(L) / ⟨l^×⟩`.** `MilnorKQ (constUnits l L)` is
the quotient of `MilnorKQ ⊥ = 𝒦_*(L)` by the two-sided ideal generated by the elements `ι [c]`,
`c ∈ lˣ` (the image of `lˣ ⊆ 𝒦_1(L)`). This is `quotEquiv` for `⊥ ≤ constUnits l L`. -/
noncomputable def relQuotEquiv :
    RingQuot (ConstRel ⊥ (constUnits l L)) ≃ₐ[ℚ] MilnorKQ (constUnits l L) :=
  quotEquiv bot_le

end Relative

end MilnorKQ

/-! ### The relative comparison in terms of `ℚ ⊗ K^M_*(L)` -/

namespace MilnorK

/-- The relation `1 ⊗ ι c ~ 0` for `c ∈ H` on `ℚ ⊗[ℤ] K^M_*(L)`. The quotient
`RingQuot (ConstRel H)` is the quotient of `ℚ ⊗[ℤ] K^M_*(L)` by the two-sided ideal generated by
the `1 ⊗ ι c`, `c ∈ H`. -/
inductive ConstRel (H : Subgroup Lˣ) : ℚ ⊗[ℤ] MilnorK L → ℚ ⊗[ℤ] MilnorK L → Prop
  | mk (c : Lˣ) (hc : c ∈ H) : ConstRel H ((1 : ℚ) ⊗ₜ ι L (.ofMul c)) 0

variable {H : Subgroup Lˣ}

variable (H) in
/-- The algebra homomorphism `(ℚ ⊗[ℤ] K^M_*(L)) / ⟨1 ⊗ ι c | c ∈ H⟩ → MilnorKQ H` induced by
`proj ∘ ratEquiv`. -/
noncomputable def quotToMilnorKQ : RingQuot (ConstRel H) →ₐ[ℚ] MilnorKQ H :=
  RingQuot.liftAlgHom ℚ ⟨(MilnorKQ.proj bot_le).comp (ratEquiv L).toAlgHom, fun _ _ r ↦ by
    cases r with
    | mk c hc =>
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, ratEquiv_one_tmul_ι, MilnorKQ.proj_ι,
        proj_cls, cls_eq_zero_of_mem hc, map_zero]⟩

theorem quotToMilnorKQ_mk (x : ℚ ⊗[ℤ] MilnorK L) :
    quotToMilnorKQ H (RingQuot.mkAlgHom ℚ (ConstRel H) x) = MilnorKQ.proj bot_le (ratEquiv L x) :=
  RingQuot.liftAlgHom_mkAlgHom_apply ℚ _ _ x

variable (H) in
/-- The `ℚ`-linear map `VOf H → (ℚ ⊗[ℤ] K^M_*(L)) / ⟨1 ⊗ ι c | c ∈ H⟩`, `[a] ↦ 1 ⊗ ι a`. -/
noncomputable def ofVOfQuot : VOf H →ₗ[ℚ] RingQuot (ConstRel H) :=
  VOf.lift ((RingQuot.mkAlgHom ℚ (ConstRel H)).toLinearMap.toAddMonoidHom.comp
    ((TensorProduct.mk ℤ ℚ (MilnorK L) 1).toAddMonoidHom.comp (ι L))) fun c hc ↦
    (RingQuot.mkAlgHom_rel ℚ (ConstRel.mk c hc)).trans (map_zero _)

theorem ofVOfQuot_cls (a : Lˣ) :
    ofVOfQuot H (cls H (.ofMul a)) = RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ ι L (.ofMul a)) :=
  VOf.lift_cls _ _ a

variable (H) in
/-- The algebra homomorphism `MilnorKQ H → (ℚ ⊗[ℤ] K^M_*(L)) / ⟨1 ⊗ ι c | c ∈ H⟩`,
`ι [a] ↦ 1 ⊗ ι a`. -/
noncomputable def ofMilnorKQQuot : MilnorKQ H →ₐ[ℚ] RingQuot (ConstRel H) :=
  MilnorKQ.lift (ofVOfQuot H) fun a b hab ↦ by
    rw [ofVOfQuot_cls, ofVOfQuot_cls, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
      ι_mul_ι_eq_zero L hab, tmul_zero, map_zero]

theorem ofMilnorKQQuot_ι_cls (a : Lˣ) :
    ofMilnorKQQuot H (MilnorKQ.ι H (cls H (.ofMul a))) =
      RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ ι L (.ofMul a)) := by
  rw [ofMilnorKQQuot, MilnorKQ.lift_ι, ofVOfQuot_cls]

variable (H) in
/-- **Comparison with the paper's `𝒦_*(L|l) = (ℚ ⊗ K^M_*(L)) / ⟨l^×⟩`.** For a subgroup `H ≤ Lˣ`,
`MilnorKQ H` is the quotient of `ℚ ⊗[ℤ] K^M_*(L)` by the two-sided ideal generated by the
elements `1 ⊗ ι c`, `c ∈ H`: the isomorphism `RingQuot (ConstRel H) ≃ₐ[ℚ] MilnorKQ H` is induced by
`proj ∘ ratEquiv` (`quotEquiv_mk`) and sends the class of `1 ⊗ ι a` to `ι [a]`
(`quotEquiv_mk_one_tmul_ι`). For `H = constUnits l L` this is the paper's
`𝒦_*(L|l) = 𝒦_*(L) / ⟨l^×⟩`, with `𝒦_*(L) = ℚ ⊗ K^M_*(L)`.

Here the quotient by the two-sided ideal is `RingQuot` of the relation `1 ⊗ ι c ~ 0`, `c ∈ H`;
see `ker_proj_comp_ratEquiv` for the formulation with `TwoSidedIdeal.span`. -/
noncomputable def quotEquiv : RingQuot (ConstRel H) ≃ₐ[ℚ] MilnorKQ H :=
  AlgEquiv.ofAlgHom (quotToMilnorKQ H) (ofMilnorKQQuot H)
    (MilnorKQ.algHom_ext <| VOf.linearMap_ext fun a ↦ by
      simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply,
        AlgHom.id_apply]
      rw [ofMilnorKQQuot_ι_cls, quotToMilnorKQ_mk, ratEquiv_one_tmul_ι, MilnorKQ.proj_ι, proj_cls])
    (RingQuot.ringQuot_ext' ℚ _ _ <| ratAlgHom_ext fun a ↦ by
      simp only [AlgHom.comp_apply, AlgHom.id_apply]
      rw [quotToMilnorKQ_mk, ratEquiv_one_tmul_ι, MilnorKQ.proj_ι, proj_cls, ofMilnorKQQuot_ι_cls])

@[simp]
theorem quotEquiv_mk (x : ℚ ⊗[ℤ] MilnorK L) :
    quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) x) = MilnorKQ.proj bot_le (ratEquiv L x) :=
  quotToMilnorKQ_mk x

/-- The isomorphism `quotEquiv` in degree one: the class of `1 ⊗ ι a` maps to `ι [a]`. -/
theorem quotEquiv_mk_one_tmul_ι (a : Lˣ) :
    quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ ι L (.ofMul a))) =
      MilnorKQ.ι H (cls H (.ofMul a)) := by
  rw [quotEquiv_mk, ratEquiv_one_tmul_ι, MilnorKQ.proj_ι, proj_cls]

/-- The isomorphism `quotEquiv` on symbols: the class of `1 ⊗ {a, b}` maps to `{a, b}`. -/
theorem quotEquiv_mk_one_tmul_symbol (a b : Lˣ) :
    quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ symbol L a b)) =
      MilnorKQ.symbol H a b := by
  rw [quotEquiv_mk, ratEquiv_one_tmul_symbol, MilnorKQ.proj_symbol]

@[simp]
theorem quotEquiv_symm_ι_cls (a : Lˣ) :
    (quotEquiv H).symm (MilnorKQ.ι H (cls H (.ofMul a))) =
      RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ ι L (.ofMul a)) := by
  rw [AlgEquiv.symm_apply_eq, quotEquiv_mk_one_tmul_ι]

variable (H) in
/-- **The kernel of `ℚ ⊗ K^M_*(L) → MilnorKQ H`.** The kernel of `proj ∘ ratEquiv` is the
two-sided ideal generated by the `1 ⊗ ι c`, `c ∈ H`. -/
theorem ker_proj_comp_ratEquiv :
    TwoSidedIdeal.ker ((MilnorKQ.proj (bot_le : ⊥ ≤ H)).comp (ratEquiv L).toAlgHom) =
      TwoSidedIdeal.span {x | ∃ c ∈ H, (1 : ℚ) ⊗ₜ ι L (.ofMul c) = x} := by
  have hker : TwoSidedIdeal.ker ((MilnorKQ.proj (bot_le : ⊥ ≤ H)).comp (ratEquiv L).toAlgHom) =
      TwoSidedIdeal.ker
        (((quotEquiv H).toRingEquiv.toRingHom).comp (RingQuot.mkRingHom (ConstRel H))) :=
    TwoSidedIdeal.ext fun x ↦ by
      rw [TwoSidedIdeal.mem_ker, TwoSidedIdeal.mem_ker, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
        ← quotEquiv_mk, RingHom.comp_apply, ← RingQuot.mkAlgHom_coe ℚ]
      rfl
  rw [hker, ker_comp_mkRingHom_eq_span (quotEquiv H).toRingEquiv.toRingHom (quotEquiv H).injective]
  congr 1
  ext z
  constructor
  · rintro ⟨x, y, ⟨c, hc⟩, rfl⟩
    exact ⟨c, hc, (sub_zero _).symm⟩
  · rintro ⟨c, hc, rfl⟩
    exact ⟨_, _, ConstRel.mk c hc, sub_zero _⟩

/-- The relative comparison is compatible with the maps induced by a ring homomorphism
`τ : K →+* L` with `τ(H₀) ⊆ H`: `τ_*` on `MilnorKQ` corresponds to `id_ℚ ⊗ τ_*`. -/
theorem quotEquiv_mk_ratMap (τ : K →+* L) {H₀ : Subgroup Kˣ}
    (h : H₀ ≤ H.comap (Units.map (τ : K →* L))) (x : ℚ ⊗[ℤ] MilnorK K) :
    quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) (ratMap τ x)) =
      MilnorKQ.map τ h (quotEquiv H₀ (RingQuot.mkAlgHom ℚ (ConstRel H₀) x)) := by
  have key : (MilnorKQ.proj (bot_le : ⊥ ≤ H)).comp (MilnorKQ.map τ bot_le) =
      (MilnorKQ.map τ h).comp (MilnorKQ.proj (bot_le : ⊥ ≤ H₀)) :=
    MilnorKQ.algHom_ext <| VOf.linearMap_ext fun a ↦ by
      simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply,
        MilnorKQ.map_ι, MilnorKQ.proj_ι, mapRingHom_cls, proj_cls]
  rw [quotEquiv_mk, quotEquiv_mk, ratEquiv_ratMap, ← AlgHom.comp_apply, key, AlgHom.comp_apply]

/-- The relative comparison is graded: it maps the class of `q ⊗ x`, `x ∈ K^M_n(L)`, into
`MilnorKQ.grade H n`. -/
theorem quotEquiv_mk_tmul_mem_grade (q : ℚ) {n : ℕ} {x : MilnorK L} (hx : x ∈ grade L n) :
    quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) (q ⊗ₜ x)) ∈ MilnorKQ.grade H n := by
  rw [quotEquiv_mk]
  exact MilnorKQ.isGraded_proj bot_le n (Submodule.mem_map_of_mem (ratEquiv_tmul_mem_grade q hx))

variable (H) in
/-- The relative comparison is graded: `MilnorKQ.grade H n` is the `ℚ`-span of the image of the
classes of `1 ⊗ K^M_n(L)`. -/
theorem grade_eq_span (n : ℕ) :
    MilnorKQ.grade H n = Submodule.span ℚ
      ((fun x ↦ quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) ((1 : ℚ) ⊗ₜ x))) '' grade L n) := by
  rw [MilnorKQ.grade_eq_map_proj (bot_le : ⊥ ≤ H), grade_bot_eq_span, Submodule.map_span,
    Set.image_image]
  simp only [quotEquiv_mk]
  rfl

/-- The relative comparison is compatible with `r^deg`: if `x ∈ K^M_n(L)`, then `r^deg` maps the
class of `q ⊗ x` to the class of `(r ^ n q) ⊗ x`. -/
theorem degScale_quotEquiv_mk_tmul (r q : ℚ) {n : ℕ} {x : MilnorK L} (hx : x ∈ grade L n) :
    MilnorKQ.degScale H r (quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) (q ⊗ₜ x))) =
      quotEquiv H (RingQuot.mkAlgHom ℚ (ConstRel H) ((r ^ n * q) ⊗ₜ x)) := by
  rw [quotEquiv_mk, quotEquiv_mk, ← degScale_ratEquiv_tmul r q hx, ← AlgHom.comp_apply,
    MilnorKQ.degScale_comp_proj, AlgHom.comp_apply]

section Relative

variable (l L : Type*) [Field l] [Field L] [Algebra l L]

/-- **Blueprint 1.2: the paper's `𝒦_*(L|l)`.** The quotient of `𝒦_*(L) = ℚ ⊗ K^M_*(L)` by the
two-sided ideal generated by `l^× ⊆ 𝒦_1(L)` (i.e. by the `1 ⊗ ι c`, `c ∈ lˣ`) is
`MilnorKQ (constUnits l L)`. This is `quotEquiv` for `H = constUnits l L`. -/
noncomputable def relQuotEquiv :
    RingQuot (ConstRel (constUnits l L)) ≃ₐ[ℚ] MilnorKQ (constUnits l L) :=
  quotEquiv _

end Relative

end MilnorK

end MilnorAlgDep
