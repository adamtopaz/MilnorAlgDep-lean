module

public import MilnorAlgDep.Foundations.V
public import Mathlib.Algebra.RingQuot
public import Mathlib.Algebra.TrivSqZeroExt.Basic
public import Mathlib.LinearAlgebra.TensorAlgebra.Basic

/-!
# Rational Milnor K-rings

Blueprint, Section 1.2 and the start of Section 7.

For a field `L` and a subgroup `H ≤ Lˣ`, `MilnorKQ H` is the quotient of the tensor algebra over
`ℚ` of `VOf H = ℚ ⊗[ℤ] Additive (Lˣ ⧸ H)` by the two-sided ideal generated by the Steinberg
elements `ι [a] * ι [b]` with `a + b = 1` (equivalently `ι [a] * ι [1 - a]` for `a ≠ 0, 1`).

* `MilnorKQ (⊥ : Subgroup Lˣ)` is the blueprint's `𝒦_*(L) = ℚ ⊗ K^M_*(L)`: indeed `ℚ ⊗ K^M_*(L)`
  is the quotient of the tensor algebra of `L^× ⊗ ℚ` by the Steinberg elements.
* `MilnorKQ (constUnits l L)` is the blueprint's `𝒦_*(L|l)`, the quotient of `𝒦_*(L)` by the
  ideal generated by `lˣ ⊆ 𝒦_1(L)`. (We take this as the definition; the comparison with the
  quotient of `𝒦_*(L)` is a stretch goal, see `PLAN.md`.)

## Main definitions

* `MilnorKQ H`, with `MilnorKQ.ι : VOf H →ₗ[ℚ] MilnorKQ H` and `MilnorKQ.symbol a b = {a, b}`.
* `MilnorKQ.lift`: the universal property.
* `MilnorKQ.grade n`: the degree `n` part, the `n`-th power of the image of `ι`, i.e. the image
  of the degree `n` part of the tensor algebra (`MilnorKQ.grade_eq_map`).
* `MilnorKQ.π₁ : MilnorKQ H →ₗ[ℚ] VOf H`: the projection to degree one, with `π₁ ∘ ι = id`.
* `MilnorKQ.degOne φ = π₁ ∘ φ ∘ ι`: the degree one part `φ₁` of an algebra homomorphism `φ`.
* `MilnorKQ.IsGraded φ`: `φ` preserves the grading.
* `MilnorKQ.map τ h`: the homomorphism `τ_*` induced by a ring homomorphism `τ`.
* `MilnorKQ.degScale r`: the blueprint's `r^deg`, multiplication by `r ^ n` in degree `n`.
-/

@[expose] public section

namespace MilnorAlgDep

open VOf

variable {K L : Type*} [Field K] [Field L]

namespace MilnorKQ

/-- The Steinberg relations on the tensor algebra of `VOf H`: `ι [a] * ι [b]` is related to `0`
whenever `a + b = 1` in `L` (i.e. `b = 1 - a` with `a ≠ 0, 1`). -/
inductive SteinbergRel (H : Subgroup Lˣ) :
    TensorAlgebra ℚ (VOf H) → TensorAlgebra ℚ (VOf H) → Prop
  | mk (a b : Lˣ) (hab : (a : L) + b = 1) :
      SteinbergRel H
        (TensorAlgebra.ι ℚ (cls H (.ofMul a)) * TensorAlgebra.ι ℚ (cls H (.ofMul b))) 0

end MilnorKQ

/-- Blueprint 1.2: the rational Milnor K-ring of `L` relative to the subgroup `H ≤ Lˣ`: the
quotient of the tensor algebra `T_ℚ(VOf H)` by the ideal generated by the Steinberg elements
`[a] ⊗ [1 - a]`, `a ≠ 0, 1`.

`MilnorKQ (⊥ : Subgroup Lˣ)` is the blueprint's `𝒦_*(L) = ℚ ⊗ K^M_*(L)` and, for a subfield
`l`, `MilnorKQ (constUnits l L)` is the blueprint's `𝒦_*(L|l)`. -/
def MilnorKQ (H : Subgroup Lˣ) : Type _ :=
  RingQuot (MilnorKQ.SteinbergRel H)

namespace MilnorKQ

section Basic

variable (H : Subgroup Lˣ)

noncomputable instance : Ring (MilnorKQ H) :=
  inferInstanceAs (Ring (RingQuot (SteinbergRel H)))

noncomputable instance : Algebra ℚ (MilnorKQ H) :=
  inferInstanceAs (Algebra ℚ (RingQuot (SteinbergRel H)))

/-- The quotient map `T_ℚ(VOf H) → MilnorKQ H`. -/
noncomputable def mkAlgHom : TensorAlgebra ℚ (VOf H) →ₐ[ℚ] MilnorKQ H :=
  RingQuot.mkAlgHom ℚ (SteinbergRel H)

/-- The inclusion of degree one, `VOf H → MilnorKQ H`. -/
noncomputable def ι : VOf H →ₗ[ℚ] MilnorKQ H :=
  (mkAlgHom H).toLinearMap ∘ₗ TensorAlgebra.ι ℚ

/-- The symbol `{a, b} = ι [a] * ι [b] ∈ MilnorKQ H` (degree two). -/
noncomputable def symbol (a b : Lˣ) : MilnorKQ H :=
  ι H (cls H (.ofMul a)) * ι H (cls H (.ofMul b))

/-- The Steinberg relation: `ι [a] * ι [b] = 0` if `a + b = 1`. -/
theorem ι_mul_ι_eq_zero {a b : Lˣ} (hab : (a : L) + b = 1) :
    ι H (cls H (.ofMul a)) * ι H (cls H (.ofMul b)) = 0 := by
  have h := RingQuot.mkAlgHom_rel ℚ (SteinbergRel.mk (H := H) a b hab)
  rw [map_mul, map_zero] at h
  exact h

/-- The Steinberg relation: `{a, b} = 0` if `a + b = 1`. -/
theorem symbol_eq_zero {a b : Lˣ} (hab : (a : L) + b = 1) : symbol H a b = 0 :=
  ι_mul_ι_eq_zero H hab

variable {H}

/-- The universal property of `MilnorKQ H`: a `ℚ`-linear map `f : VOf H → A` into a `ℚ`-algebra
with `f [a] * f [b] = 0` whenever `a + b = 1` extends to an algebra homomorphism
`MilnorKQ H → A`. -/
noncomputable def lift {A : Type*} [Semiring A] [Algebra ℚ A] (f : VOf H →ₗ[ℚ] A)
    (hf : ∀ a b : Lˣ, (a : L) + b = 1 → f (cls H (.ofMul a)) * f (cls H (.ofMul b)) = 0) :
    MilnorKQ H →ₐ[ℚ] A :=
  RingQuot.liftAlgHom ℚ ⟨TensorAlgebra.lift ℚ f, fun _ _ h ↦ by
    cases h with
    | mk a b hab => rw [map_mul, TensorAlgebra.lift_ι_apply, TensorAlgebra.lift_ι_apply,
        map_zero, hf a b hab]⟩

@[simp]
theorem lift_ι {A : Type*} [Semiring A] [Algebra ℚ A] (f : VOf H →ₗ[ℚ] A)
    (hf : ∀ a b : Lˣ, (a : L) + b = 1 → f (cls H (.ofMul a)) * f (cls H (.ofMul b)) = 0)
    (v : VOf H) : lift f hf (ι H v) = f v := by
  exact (RingQuot.liftAlgHom_mkAlgHom_apply ℚ (TensorAlgebra.lift ℚ f) _
    (TensorAlgebra.ι ℚ v)).trans (TensorAlgebra.lift_ι_apply f v)

/-- Two algebra homomorphisms out of `MilnorKQ H` agreeing in degree one are equal. -/
@[ext]
theorem algHom_ext {A : Type*} [Semiring A] [Algebra ℚ A] {f g : MilnorKQ H →ₐ[ℚ] A}
    (h : f.toLinearMap ∘ₗ ι H = g.toLinearMap ∘ₗ ι H) : f = g := by
  refine RingQuot.ringQuot_ext' ℚ f g (TensorAlgebra.hom_ext ?_)
  exact h

end Basic

section Grading

variable (H : Subgroup Lˣ)

/-- Blueprint 1.2: the degree `n` part `𝒦_n` of `MilnorKQ H`: the `ℚ`-span of the products of
`n` elements of degree one, i.e. `(range ι) ^ n`. Equivalently, the image of the degree `n` part
of the tensor algebra (`grade_eq_map`). -/
noncomputable def grade (n : ℕ) : Submodule ℚ (MilnorKQ H) :=
  LinearMap.range (ι H) ^ n

theorem grade_eq_map (n : ℕ) :
    grade H n =
      (LinearMap.range (TensorAlgebra.ι ℚ : VOf H →ₗ[ℚ] TensorAlgebra ℚ (VOf H)) ^ n).map
        (mkAlgHom H).toLinearMap := by
  rw [Submodule.map_pow, grade, ι, LinearMap.range_comp]

theorem ι_mem_grade_one (v : VOf H) : ι H v ∈ grade H 1 := by
  rw [grade, pow_one]
  exact LinearMap.mem_range_self _ v

end Grading

section DegreeOne

variable (H : Subgroup Lˣ)

/-- Blueprint 7: the projection `π₁ : MilnorKQ H → VOf H` onto degree one. It is defined by
lifting `v ↦ (0, v)` to an algebra homomorphism into the trivial square-zero extension
`ℚ ⊕ VOf H` and taking the second component. It satisfies `π₁ ∘ ι = id` (`π₁_ι`). -/
noncomputable def π₁ : MilnorKQ H →ₗ[ℚ] VOf H := by
  letI : Module ℚᵐᵒᵖ (VOf H) :=
    Module.compHom _ ((RingHom.id ℚ).fromOpposite fun x y ↦ Commute.all _ _)
  haveI : IsCentralScalar ℚ (VOf H) := ⟨fun _ _ ↦ rfl⟩
  exact (TrivSqZeroExt.sndHom ℚ (VOf H)).comp
    (lift (TrivSqZeroExt.inrHom ℚ (VOf H)) fun _ _ _ ↦ TrivSqZeroExt.inr_mul_inr ℚ _ _).toLinearMap

@[simp]
theorem π₁_ι (v : VOf H) : π₁ H (ι H v) = v := by
  let : Module ℚᵐᵒᵖ (VOf H) :=
    Module.compHom _ ((RingHom.id ℚ).fromOpposite fun x y ↦ Commute.all _ _)
  have : IsCentralScalar ℚ (VOf H) := ⟨fun _ _ ↦ rfl⟩
  exact congrArg TrivSqZeroExt.snd (lift_ι (TrivSqZeroExt.inrHom ℚ (VOf H))
    (fun _ _ _ ↦ TrivSqZeroExt.inr_mul_inr ℚ _ _) v)

theorem π₁_comp_ι : π₁ H ∘ₗ ι H = LinearMap.id :=
  LinearMap.ext (π₁_ι H)

variable {H} {H' : Subgroup Kˣ}

/-- The degree one part `φ₁ = π₁ ∘ φ ∘ ι : VOf H → VOf H'` of an algebra homomorphism
`φ : MilnorKQ H → MilnorKQ H'` (the blueprint's `φ_1`). If `φ` is graded (`IsGraded φ`), then
`φ ∘ ι = ι ∘ φ₁`. -/
noncomputable def degOne (φ : MilnorKQ H →ₐ[ℚ] MilnorKQ H') : VOf H →ₗ[ℚ] VOf H' :=
  π₁ H' ∘ₗ φ.toLinearMap ∘ₗ ι H

/-- An algebra homomorphism `φ : MilnorKQ H → MilnorKQ H'` is *graded* if it maps the degree `n`
part into the degree `n` part, for every `n`. -/
def IsGraded (φ : MilnorKQ H →ₐ[ℚ] MilnorKQ H') : Prop :=
  ∀ n, (grade H n).map φ.toLinearMap ≤ grade H' n

end DegreeOne

section Functoriality

variable {H : Subgroup Lˣ} {H₀ : Subgroup Kˣ}

/-- Blueprint 1.2: the homomorphism `τ_* : MilnorKQ H₀ → MilnorKQ H` induced by a ring
homomorphism `τ : K →+* L` with `τ(H₀) ⊆ H`; it sends `ι [a]` to `ι [τ a]`. -/
noncomputable def map (τ : K →+* L) (h : H₀ ≤ H.comap (Units.map (τ : K →* L))) :
    MilnorKQ H₀ →ₐ[ℚ] MilnorKQ H :=
  lift (ι H ∘ₗ VOf.mapRingHom τ h) fun a b hab ↦ by
    simp only [LinearMap.comp_apply, mapRingHom_cls]
    refine ι_mul_ι_eq_zero H ?_
    simp only [Units.coe_map, MonoidHom.coe_ofClass]
    rw [← map_add, hab, map_one]

@[simp]
theorem map_ι (τ : K →+* L) (h : H₀ ≤ H.comap (Units.map (τ : K →* L))) (v : VOf H₀) :
    map τ h (ι H₀ v) = ι H (VOf.mapRingHom τ h v) := by
  simp [map]

variable (H) in
/-- Blueprint 1.2: `r^deg : MilnorKQ H → MilnorKQ H`, multiplication by `r ^ n` in degree `n`;
it is the algebra endomorphism sending `ι v` to `r • ι v`. (An automorphism if `r ≠ 0`.) -/
noncomputable def degScale (r : ℚ) : MilnorKQ H →ₐ[ℚ] MilnorKQ H :=
  lift (r • ι H) fun a b hab ↦ by
    simp only [LinearMap.smul_apply, smul_mul_smul_comm, ι_mul_ι_eq_zero H hab, smul_zero]

@[simp]
theorem degScale_ι (r : ℚ) (v : VOf H) : degScale H r (ι H v) = r • ι H v := by
  simp [degScale]

end Functoriality

end MilnorKQ

end MilnorAlgDep
