import Mathlib.RingTheory.Valuation.LocalSubring
import Mathlib.RingTheory.Algebraic.Integral

/-!
# Existence of valuations

This file formalizes the "standard fact" stated in Section 7.1 of the blueprint, in the paragraph
just before Lemma 7.2 (`lem:symbols`):

> If `M ⊆ L` is a subfield and `b ∈ L` is transcendental over `M`, there is a valuation `v` of
> `L` which is trivial on `M` and satisfies `v(b) > 0`. Its residue field contains `M`.

It is used in the proofs of Lemma 7.2 (`lem:symbols`) and of Theorem C.

## Conventions

Valuations are encoded by Mathlib's `ValuationSubring L`. For `A : ValuationSubring L`:

* "`v` is trivial on `M`" is the hypothesis `hA : ∀ x : M, algebraMap M L x ∈ A`; every non-zero
  element of `M` is then a unit of `A` (`isUnit_toValuationSubring`,
  `valuation_algebraMap_eq_one`), and so is every non-zero element of `L` algebraic over `M`
  (`isUnit_of_isAlgebraic`).
* "`v(b) > 0`" is `A.valuation b < 1`: Mathlib's valuations are multiplicative.

## Main results

* `MilnorAlgDep.exists_valuationSubring_of_transcendental`: the standard fact.
* `MilnorAlgDep.ValuationExt.residueHom`: the embedding `M →+* IsLocalRing.ResidueField A`
  (injective: `residueHom_injective`), its units version `residueUnitsHom`, and the
  compatibility `unitGroupToResidueFieldUnits_units_map` with Mathlib's residue map on units.
* `MilnorAlgDep.ValuationExt.mem_of_isAlgebraic`, `valuation_eq_one_of_isAlgebraic`,
  `eq_of_residue_eq_of_isAlgebraic`: the valuation is trivial on the relative algebraic closure
  of `M` in `L`, and the residue map is injective on it.
* `MilnorAlgDep.ValuationExt.residue_one_sub`, `mk0_one_sub_mem_principalUnitGroup`: if
  `v(x) > 0` then `1 - x` is a unit of `A` with residue `1`.
* `MilnorAlgDep.ValuationExt.pow_residueHom_notMem_range`,
  `pow_residueUnitsHom_notMem_range`: the form of injectivity used in Lemma 7.2(a).

## Value groups

For the tame symbol (Lemma 7.1, `lem:tame`) Mathlib provides, for `A : ValuationSubring L`:

* `A.valuation : Valuation L A.ValueGroup`, where `A.ValueGroup` is a
  `LinearOrderedCommGroupWithZero`, with `A.valuation_le_one_iff`, `A.valuation_eq_one_iff`,
  `A.valuation_lt_one_iff`, `A.valuation_unit`.
* `A.unitGroup : Subgroup Lˣ`, the kernel of the valuation on `Lˣ` (`A.mem_unitGroup_iff`), and
  `A.unitGroupMulEquiv : A.unitGroup ≃* Aˣ`. So the (additive) value group `Γ_v` can be taken to
  be `Additive (Lˣ ⧸ A.unitGroup)`; it is torsion free (`pow_mem_unitGroup_iff` below), and the
  class of `b` in it has infinite order (`pow_notMem_unitGroup_of_valuation_lt_one`).
* `A.unitGroupToResidueFieldUnits : A.unitGroup →* (IsLocalRing.ResidueField A)ˣ`, surjective
  (`A.surjective_unitGroupToResidueFieldUnits`) with kernel the principal units
  `A.principalUnitGroup` (`A.ker_unitGroupToResidueFieldUnits`), i.e. the `x` with `v(x - 1) > 0`.
-/

namespace MilnorAlgDep

open IsLocalRing Polynomial

variable {M L : Type*} [Field M] [Field L] [Algebra M L]

section Existence

/-- If `b` is transcendental over `M`, then the ideal of `M[b]` generated by `b` is proper. -/
theorem span_singleton_ne_top_of_transcendental {b : L} (hb : Transcendental M b) :
    Ideal.span {(⟨b, Algebra.self_mem_adjoin_singleton M b⟩ :
      (Algebra.adjoin M {b}).toSubring)} ≠ ⊤ := by
  intro h
  rw [Ideal.eq_top_iff_one, Ideal.mem_span_singleton'] at h
  obtain ⟨⟨y, hy⟩, hyb⟩ := h
  have hyb' : y * b = 1 := congrArg Subtype.val hyb
  rw [Subalgebra.mem_toSubring, Algebra.adjoin_singleton_eq_range_aeval] at hy
  obtain ⟨p, rfl⟩ := hy
  have hpb : aeval b p * b = 1 := hyb'
  have hp : p * X - 1 = 0 := transcendental_iff.mp hb _ (by simp [hpb])
  exact not_isUnit_X (IsUnit.of_mul_eq_one_right p (sub_eq_zero.mp hp))

/-- The standard fact of Section 7.1 of the blueprint (paragraph before Lemma 7.2): if `b ∈ L`
is transcendental over `M`, there is a valuation of `L` which is trivial on `M` and positive at
`b`, i.e. a valuation subring `A` of `L` containing `M` and `b`, with `b` in the maximal ideal of
`A` (see `mem_maximalIdeal_of_valuation_lt_one`).

Proof: `b` is a non-unit of the subring `M[b]`, and a proper ideal of a subring of a field is
contained in the non-units of a dominating valuation subring. -/
theorem exists_valuationSubring_of_transcendental {b : L} (hb : Transcendental M b) :
    ∃ A : ValuationSubring L, (∀ x : M, algebraMap M L x ∈ A) ∧ b ∈ A ∧ A.valuation b < 1 := by
  obtain ⟨A, hle, hI⟩ := Ideal.image_subset_nonunits_valuationSubring _
    (span_singleton_ne_top_of_transcendental hb)
  have hbA : b ∈ A.nonunits := hI ⟨_, Ideal.subset_span rfl, rfl⟩
  exact ⟨A, fun x ↦ hle (Subalgebra.algebraMap_mem _ x), A.nonunits_subset hbA,
    A.mem_nonunits_iff.mp hbA⟩

end Existence

namespace ValuationExt

section General

variable {A : ValuationSubring L}

/-- An element of positive valuation lies in the valuation ring. -/
theorem mem_of_valuation_lt_one {x : L} (hx : A.valuation x < 1) : x ∈ A :=
  (A.valuation_le_one_iff x).mp hx.le

/-- An element of positive valuation lies in the maximal ideal of the valuation ring. -/
theorem mem_maximalIdeal_of_valuation_lt_one {x : L} (hx : A.valuation x < 1) :
    (⟨x, mem_of_valuation_lt_one hx⟩ : A) ∈ maximalIdeal A :=
  (A.valuation_lt_one_iff _).mpr hx

/-- An element of positive valuation is not a unit of the valuation ring. -/
theorem not_isUnit_of_valuation_lt_one {x : L} (hx : A.valuation x < 1) :
    ¬ IsUnit (⟨x, mem_of_valuation_lt_one hx⟩ : A) :=
  mem_maximalIdeal_of_valuation_lt_one hx

/-- If `v(x) > 0`, then `v(1 - x) = 0`. -/
theorem valuation_one_sub_eq_one {x : L} (hx : A.valuation x < 1) : A.valuation (1 - x) = 1 :=
  A.valuation.map_one_sub_of_lt hx

/-- If `v(x) > 0`, then `1 - x ≠ 0`. -/
theorem one_sub_ne_zero_of_valuation_lt_one {x : L} (hx : A.valuation x < 1) : 1 - x ≠ 0 := by
  intro h
  simpa [h] using valuation_one_sub_eq_one hx

/-- If `v(x) > 0`, then `1 - x` lies in the valuation ring. -/
theorem one_sub_mem_of_valuation_lt_one {x : L} (hx : A.valuation x < 1) : 1 - x ∈ A :=
  (A.valuation_le_one_iff _).mp (valuation_one_sub_eq_one hx).le

/-- If `v(x) > 0`, then `1 - x` is a unit of the valuation ring. -/
theorem isUnit_one_sub {x : L} (hx : A.valuation x < 1) :
    IsUnit (⟨1 - x, one_sub_mem_of_valuation_lt_one hx⟩ : A) :=
  (A.valuation_eq_one_iff _).mpr (valuation_one_sub_eq_one hx)

/-- If `v(x) > 0`, then `1 - x` has residue `1`. -/
theorem residue_one_sub {x : L} (hx : A.valuation x < 1) :
    residue A ⟨1 - x, one_sub_mem_of_valuation_lt_one hx⟩ = 1 := by
  have h : (⟨1 - x, one_sub_mem_of_valuation_lt_one hx⟩ : A) =
      1 - ⟨x, mem_of_valuation_lt_one hx⟩ := rfl
  rw [h, map_sub, map_one, (residue_eq_zero_iff _).mpr (mem_maximalIdeal_of_valuation_lt_one hx),
    sub_zero]

/-- If `v(x) > 0`, then `1 - x` is a principal unit (`v((1 - x) - 1) > 0`): it lies in the kernel
of `A.unitGroupToResidueFieldUnits`. -/
theorem mk0_one_sub_mem_principalUnitGroup {x : L} (hx : A.valuation x < 1) :
    Units.mk0 (1 - x) (one_sub_ne_zero_of_valuation_lt_one hx) ∈ A.principalUnitGroup := by
  rw [ValuationSubring.mem_principalUnitGroup_iff, Units.val_mk0, sub_sub_cancel_left,
    Valuation.map_neg]
  exact hx

/-- The value group `Lˣ ⧸ A.unitGroup` is torsion free. -/
theorem pow_mem_unitGroup_iff {x : Lˣ} {n : ℕ} (hn : n ≠ 0) :
    x ^ n ∈ A.unitGroup ↔ x ∈ A.unitGroup := by
  simp only [ValuationSubring.mem_unitGroup_iff, Units.val_pow_eq_pow_val, map_pow]
  refine ⟨fun h ↦ ?_, fun h ↦ by rw [h, one_pow]⟩
  rcases lt_trichotomy (A.valuation x) 1 with hlt | heq | hgt
  · exact absurd h (pow_lt_one₀ zero_le hlt hn).ne
  · exact heq
  · exact absurd h (one_lt_pow₀ hgt hn).ne'

/-- If `v(x) > 0`, then no positive power of `x` is a unit of `A`: the class of `x` in the value
group `Lˣ ⧸ A.unitGroup` has infinite order. -/
theorem pow_notMem_unitGroup_of_valuation_lt_one {x : Lˣ} (hx : A.valuation x < 1) {n : ℕ}
    (hn : n ≠ 0) : x ^ n ∉ A.unitGroup := by
  rw [pow_mem_unitGroup_iff hn, ValuationSubring.mem_unitGroup_iff]
  exact hx.ne

end General

variable {A : ValuationSubring L} (hA : ∀ x : M, algebraMap M L x ∈ A)

/-- The inclusion `M → A` of a field `M` on which the valuation of `A` is trivial. -/
def toValuationSubring : M →+* A := (algebraMap M L).codRestrict A hA

@[simp]
theorem coe_toValuationSubring (x : M) : (toValuationSubring hA x : L) = algebraMap M L x := rfl

theorem algebraMap_comp_toValuationSubring :
    (algebraMap A L).comp (toValuationSubring hA) = algebraMap M L := rfl

/-- If the valuation of `A` is trivial on `M`, then every non-zero element of `M` is a unit
of `A`. -/
theorem isUnit_toValuationSubring {x : M} (hx : x ≠ 0) : IsUnit (toValuationSubring hA x) :=
  hx.isUnit.map _

include hA in
/-- If the valuation of `A` is trivial on `M`, then `v(x) = 0` (multiplicatively: `= 1`) for
every non-zero `x ∈ M`. -/
theorem valuation_algebraMap_eq_one {x : M} (hx : x ≠ 0) : A.valuation (algebraMap M L x) = 1 :=
  (A.valuation_eq_one_iff _).mp (isUnit_toValuationSubring hA hx)

include hA in
/-- If the valuation of `A` is trivial on `M`, then `Mˣ` maps into `A.unitGroup`. -/
theorem units_map_mem_unitGroup (u : Mˣ) :
    Units.map (algebraMap M L).toMonoidHom u ∈ A.unitGroup :=
  (A.mem_unitGroup_iff _).mpr (valuation_algebraMap_eq_one hA u.ne_zero)

section Residue

/-- "Its residue field contains `M`": the ring homomorphism `M → κ` to the residue field of a
valuation trivial on `M`. It is injective (`residueHom_injective`). -/
noncomputable def residueHom : M →+* ResidueField A := (residue A).comp (toValuationSubring hA)

theorem residueHom_apply (x : M) : residueHom hA x = residue A (toValuationSubring hA x) := rfl

theorem residueHom_injective : Function.Injective (residueHom hA) := (residueHom hA).injective

/-- The `M`-algebra structure on the residue field defined by `residueHom` (not an instance, as it
depends on `hA`; use `letI := residueAlgebra hA`). -/
noncomputable abbrev residueAlgebra : Algebra M (ResidueField A) := (residueHom hA).toAlgebra

/-- The injective homomorphism `Mˣ → κˣ` induced by `residueHom`. -/
noncomputable def residueUnitsHom : Mˣ →* (ResidueField A)ˣ := Units.map (residueHom hA).toMonoidHom

@[simp]
theorem coe_residueUnitsHom (u : Mˣ) : (residueUnitsHom hA u : ResidueField A) = residueHom hA u :=
  rfl

theorem residueUnitsHom_injective : Function.Injective (residueUnitsHom hA) :=
  Units.map_injective (residueHom_injective hA)

/-- `residueUnitsHom` agrees with Mathlib's residue map on units
`A.unitGroupToResidueFieldUnits`. -/
theorem unitGroupToResidueFieldUnits_units_map (u : Mˣ) :
    A.unitGroupToResidueFieldUnits ⟨_, units_map_mem_unitGroup hA u⟩ = residueUnitsHom hA u :=
  Units.ext rfl

/-- The residue class of `u ∈ Mˣ` has the same order as `u`; in particular it is a root of unity
if and only if `u` is. -/
theorem orderOf_residueUnitsHom (u : Mˣ) : orderOf (residueUnitsHom hA u) = orderOf u :=
  orderOf_injective _ (residueUnitsHom_injective hA) u

end Residue

section Algebraic

include hA

/-- A valuation trivial on `M` is trivial on the elements of `L` algebraic over `M`: they lie in
the valuation ring (which is integrally closed). -/
theorem mem_of_isAlgebraic {x : L} (hx : IsAlgebraic M x) : x ∈ A := by
  have hint : IsIntegral A x := by
    apply RingHom.isIntegralElem.of_comp (f := toValuationSubring hA)
    rw [algebraMap_comp_toValuationSubring]
    exact hx.isIntegral
  obtain ⟨y, rfl⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
  exact y.2

/-- A valuation trivial on `M` is trivial on the non-zero elements of `L` algebraic over `M`. -/
theorem valuation_eq_one_of_isAlgebraic {x : L} (hx : IsAlgebraic M x) (hx0 : x ≠ 0) :
    A.valuation x = 1 := by
  have h1 : A.valuation x ≤ 1 := (A.valuation_le_one_iff x).mpr (mem_of_isAlgebraic hA hx)
  have h2 : A.valuation x⁻¹ ≤ 1 := (A.valuation_le_one_iff _).mpr (mem_of_isAlgebraic hA hx.inv)
  have h0 : 0 < A.valuation x := zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hx0)
  rw [map_inv₀, inv_le_one₀ h0] at h2
  exact le_antisymm h1 h2

/-- If the valuation of `A` is trivial on `M`, every non-zero `x ∈ L` algebraic over `M` is a unit
of `A`. -/
theorem isUnit_of_isAlgebraic {x : L} (hx : IsAlgebraic M x) (hx0 : x ≠ 0) :
    IsUnit (⟨x, mem_of_isAlgebraic hA hx⟩ : A) :=
  (A.valuation_eq_one_iff _).mpr (valuation_eq_one_of_isAlgebraic hA hx hx0)

/-- The `Lˣ`-version of `isUnit_of_isAlgebraic`. -/
theorem mem_unitGroup_of_isAlgebraic {x : Lˣ} (hx : IsAlgebraic M (x : L)) :
    x ∈ A.unitGroup :=
  (A.mem_unitGroup_iff _).mpr (valuation_eq_one_of_isAlgebraic hA hx x.ne_zero)

/-- The residue map is injective on the elements of `L` algebraic over `M` (the relative algebraic
closure of `M` in `L` embeds in the residue field). -/
theorem eq_of_residue_eq_of_isAlgebraic {x y : L} (hx : IsAlgebraic M x) (hy : IsAlgebraic M y)
    (h : residue A ⟨x, mem_of_isAlgebraic hA hx⟩ = residue A ⟨y, mem_of_isAlgebraic hA hy⟩) :
    x = y := by
  by_contra hxy
  have hsub : IsAlgebraic M (x - y) := (hx.isIntegral.sub hy.isIntegral).isAlgebraic
  have hu := isUnit_of_isAlgebraic hA hsub (sub_ne_zero.mpr hxy)
  have hmem : (⟨x - y, mem_of_isAlgebraic hA hsub⟩ : A) ∈ maximalIdeal A := by
    rw [← residue_eq_zero_iff]
    have : (⟨x - y, mem_of_isAlgebraic hA hsub⟩ : A) =
        ⟨x, mem_of_isAlgebraic hA hx⟩ - ⟨y, mem_of_isAlgebraic hA hy⟩ := rfl
    rw [this, map_sub, h, sub_self]
  exact hmem hu

end Algebraic

section Tower

/-! ### An intermediate field `l ⊆ M`

This is the situation of Lemma 7.2(a): `l ⊆ M ⊆ L`, the valuation is trivial on `M`, and
`a ∈ M` has no positive power in `l`. Then the residue class of `a` has no positive power in the
image of `l` in the residue field. -/

variable {l : Type*} [Field l] [Algebra l M]

/-- Used in Lemma 7.2(a): if no positive power of `a ∈ M` lies in `l`, then no positive power of
its residue class lies in the image of `l` in the residue field. -/
theorem pow_residueHom_notMem_range {a : M}
    (ha : ∀ n : ℕ, n ≠ 0 → a ^ n ∉ Set.range (algebraMap l M)) {n : ℕ} (hn : n ≠ 0) :
    residueHom hA a ^ n ∉ Set.range ((residueHom hA).comp (algebraMap l M)) := by
  rintro ⟨c, hc⟩
  refine ha n hn ⟨c, residueHom_injective hA ?_⟩
  rwa [map_pow]

/-- The units version of `pow_residueHom_notMem_range`: if no positive power of `a ∈ Mˣ` comes
from `lˣ`, then no positive power of its residue class lies in the image of `lˣ` in `κˣ`. -/
theorem pow_residueUnitsHom_notMem_range {a : Mˣ}
    (ha : ∀ n : ℕ, n ≠ 0 → a ^ n ∉ (Units.map (algebraMap l M).toMonoidHom).range) {n : ℕ}
    (hn : n ≠ 0) :
    residueUnitsHom hA a ^ n ∉
      ((residueUnitsHom hA).comp (Units.map (algebraMap l M).toMonoidHom)).range := by
  rintro ⟨c, hc⟩
  refine ha n hn ⟨c, residueUnitsHom_injective hA ?_⟩
  rwa [map_pow]

variable [Algebra l L] [IsScalarTower l M L]

include hA in
/-- A valuation trivial on `M` is trivial on `l ⊆ M`. -/
theorem algebraMap_mem_of_isScalarTower (c : l) : algebraMap l L c ∈ A := by
  rw [IsScalarTower.algebraMap_apply l M L]
  exact hA _

/-- The embedding `l → κ` obtained from `l ⊆ L` agrees with the composite `l → M → κ`. -/
theorem residueHom_comp_algebraMap :
    (residueHom hA).comp (algebraMap l M) = residueHom (algebraMap_mem_of_isScalarTower hA) := by
  ext c
  simp only [RingHom.comp_apply, residueHom_apply]
  congr 1
  ext
  simp [IsScalarTower.algebraMap_apply l M L]

end Tower

end ValuationExt

end MilnorAlgDep
