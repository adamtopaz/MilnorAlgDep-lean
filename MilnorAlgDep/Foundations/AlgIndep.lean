module

public import MilnorAlgDep.Foundations.V
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis

/-!
# Algebraic independence in `V_{L|l}`

Blueprint, Section 1.1 and (V3) in Section 2.3.

A family `v : ι → V l L` is *algebraically independent over `l`* if there are representatives
`N i ≥ 1`, `a i : Lˣ` with `N i • v i = [a i]` such that the family `a` is algebraically
independent over `l` (in the sense of Mathlib's `AlgebraicIndependent`). This does not depend on
the choice of representatives (`VAlgIndep.iff_of_nsmul_eq_cls`). Elements are *algebraically
dependent* if they are not algebraically independent.

Note that an algebraically independent family consists of non-zero elements
(`VAlgIndep.ne_zero`), and is injective.

## Auxiliary results

* `mem_matroid_closure_iff`: membership in the closure of the algebraic matroid of `L / l`.
* `algebraicIndependent_of_isAlgebraic_adjoin`: if `w` is algebraically independent and each
  `w i`, `y i` is algebraic over `l(y i)`, resp. `l(w i)`, then `y` is algebraically independent.
* `V.isAlgebraic_adjoin_of_zsmul_cls_eq`: if `M • [a] = N • [b]` with `M ≥ 1`, then `a` is
  algebraic over `l(b)`.
-/

@[expose] public section

namespace MilnorAlgDep

open VOf IntermediateField

variable {l L : Type*} [Field l] [Field L] [Algebra l L] {ι : Type*}

section Matroid

variable (l) in
/-- Membership in the closure of the algebraic matroid of `L / l`: `x` lies in the closure of `s`
if and only if it is algebraic over the subalgebra generated by `s`. -/
theorem mem_matroid_closure_iff {s : Set L} {x : L} :
    x ∈ (AlgebraicIndependent.matroid l L).closure s ↔ IsAlgebraic (Algebra.adjoin l s) x := by
  rw [AlgebraicIndependent.matroid_closure_eq, SetLike.mem_coe, Subalgebra.mem_algebraicClosure]

/-- `x` is algebraic over `l(z)` iff it lies in the closure of `{z}` in the algebraic matroid. -/
theorem isAlgebraic_adjoin_simple_iff_mem_closure {x z : L} :
    IsAlgebraic l⟮z⟯ x ↔ x ∈ (AlgebraicIndependent.matroid l L).closure {z} := by
  rw [mem_matroid_closure_iff, IntermediateField.isAlgebraic_adjoin_iff]

/-- If `w` is algebraically independent over `l`, and for each `i` the elements `w i` and `y i`
are algebraic over `l(y i)` and `l(w i)` respectively, then `y` is algebraically independent
over `l`. -/
theorem algebraicIndependent_of_isAlgebraic_adjoin {w y : ι → L}
    (hw : AlgebraicIndependent l w) (hwy : ∀ i, IsAlgebraic l⟮y i⟯ (w i))
    (hyw : ∀ i, IsAlgebraic l⟮w i⟯ (y i)) : AlgebraicIndependent l y := by
  set Mt := AlgebraicIndependent.matroid l L
  refine algebraicIndependent_of_finite_type' (algebraMap l L).injective fun t _ _ i hi halg ↦ ?_
  have hyt : y '' t ⊆ Mt.closure (w '' t) := by
    rintro _ ⟨j, hj, rfl⟩
    exact Mt.closure_mono (Set.singleton_subset_iff.2 (Set.mem_image_of_mem w hj))
      (isAlgebraic_adjoin_simple_iff_mem_closure.1 (hyw j))
  have hyi : y i ∈ Mt.closure (w '' t) :=
    Mt.closure_subset_closure_of_subset_closure hyt ((mem_matroid_closure_iff l).2 halg)
  have hwi : w i ∈ Mt.closure (w '' t) :=
    Mt.closure_subset_closure_of_subset_closure (Set.singleton_subset_iff.2 hyi)
      (isAlgebraic_adjoin_simple_iff_mem_closure.1 (hwy i))
  exact hw.transcendental_adjoin hi ((mem_matroid_closure_iff l).1 hwi)

/-- Algebraic independence of a pair: `a, b` are algebraically independent over `l` iff `a` is
transcendental over `l` and `b` is transcendental over `l(a)`. -/
theorem algebraicIndependent_pair_iff {a b : L} :
    AlgebraicIndependent l ![a, b] ↔ Transcendental l a ∧ Transcendental l⟮a⟯ b := by
  rw [AlgebraicIndependent.iff_transcendental_adjoin_image (1 : Fin 2)]
  have himage : ![a, b] '' {1}ᶜ = {a} := by
    have : ({1}ᶜ : Set (Fin 2)) = {0} := by
      ext j
      fin_cases j <;> simp
    rw [this, Set.image_singleton]
    rfl
  have key : ∀ x y : Fin 2, x ≠ 1 → y ≠ 1 → x = y := by decide
  have : Subsingleton {j : Fin 2 // j ≠ 1} :=
    ⟨fun ⟨x, hx⟩ ⟨y, hy⟩ ↦ Subtype.ext (key x y hx hy)⟩
  rw [algebraicIndependent_singleton_iff ⟨0, by simp⟩, himage,
    IntermediateField.transcendental_adjoin_iff]
  rfl

/-- `a, b` are algebraically independent iff `b, a` are. -/
theorem algebraicIndependent_pair_comm {a b : L} :
    AlgebraicIndependent l ![a, b] ↔ AlgebraicIndependent l ![b, a] := by
  have : ![b, a] = ![a, b] ∘ Equiv.swap (0 : Fin 2) 1 := by
    ext i
    fin_cases i <;> rfl
  rw [this, algebraicIndependent_equiv]

end Matroid

namespace V

/-- If `M • [a] = N • [b]` in `V l L` with `M ≥ 1` (and `N ∈ ℤ` arbitrary), then `a` is algebraic
over `l(b)`: indeed `a ^ (M k) = c * b ^ (N k)` for some `k ≥ 1` and `c ∈ l`. -/
theorem isAlgebraic_adjoin_of_zsmul_cls_eq {a b : Lˣ} {M : ℕ} (hM : 0 < M) {N : ℤ}
    (h : (M : ℤ) • cls (constUnits l L) (.ofMul a) = N • cls (constUnits l L) (.ofMul b)) :
    IsAlgebraic l⟮(b : L)⟯ (a : L) := by
  have h0 : cls (constUnits l L) (.ofMul (a ^ (M : ℤ) * (b ^ N)⁻¹)) = 0 := by
    rw [cls_mul, cls_inv, cls_zpow, cls_zpow, h, add_neg_cancel]
  obtain ⟨k, hk, hmem⟩ := (VOf.cls_eq_zero_iff _).1 h0
  obtain ⟨c, hc⟩ := mem_constUnits.1 hmem
  have hpow : (a : L) ^ (M * k) = algebraMap l L c * ((b : L) ^ N) ^ k := by
    rw [hc]
    simp only [Units.val_pow_eq_pow_val, Units.val_mul, Units.val_inv_eq_inv_val,
      Units.val_zpow_eq_zpow_val, zpow_natCast]
    rw [mul_pow, inv_pow, mul_assoc, inv_mul_cancel₀ (pow_ne_zero _ (zpow_ne_zero _ b.ne_zero)),
      mul_one, pow_mul]
  have hmem' : (a : L) ^ (M * k) ∈ l⟮(b : L)⟯ := by
    rw [hpow]
    exact mul_mem (IntermediateField.algebraMap_mem _ c)
      (pow_mem (zpow_mem (mem_adjoin_simple_self l (b : L)) N) k)
  exact IsAlgebraic.of_pow (Nat.mul_pos hM hk) (isAlgebraic_algebraMap (⟨_, hmem'⟩ : l⟮(b : L)⟯))

end V

variable (l) in
/-- Blueprint 1.1 / (V3): a family `v : ι → V l L` is *algebraically independent over `l`* if
for some choice of integers `N i ≥ 1` and units `a i` with `N i • v i = [a i]`, the family
`(a i)` is algebraically independent over `l`.

By `VAlgIndep.iff_of_nsmul_eq_cls` the choice does not matter. Elements are *algebraically
dependent* if they are not algebraically independent (`¬ VAlgIndep l v`). -/
def VAlgIndep (v : ι → V l L) : Prop :=
  ∃ (N : ι → ℕ) (a : ι → Lˣ), (∀ i, 0 < N i) ∧
    (∀ i, N i • v i = cls (constUnits l L) (.ofMul (a i))) ∧
    AlgebraicIndependent l (fun i ↦ (a i : L))

namespace VAlgIndep

/-- Blueprint 1.1: algebraic independence in `V l L` does not depend on the choice of
representatives. -/
theorem iff_of_nsmul_eq_cls {v : ι → V l L} {N : ι → ℕ} {a : ι → Lˣ} (hN : ∀ i, 0 < N i)
    (ha : ∀ i, N i • v i = cls (constUnits l L) (.ofMul (a i))) :
    VAlgIndep l v ↔ AlgebraicIndependent l (fun i ↦ (a i : L)) := by
  refine ⟨fun ⟨M, b, hM, hb, hind⟩ ↦ ?_, fun h ↦ ⟨N, a, hN, ha, h⟩⟩
  refine algebraicIndependent_of_isAlgebraic_adjoin hind (fun i ↦ ?_) (fun i ↦ ?_)
  · refine V.isAlgebraic_adjoin_of_zsmul_cls_eq (hN i) (N := M i) ?_
    rw [natCast_zsmul, natCast_zsmul, ← hb i, ← ha i, smul_smul, smul_smul, mul_comm]
  · refine V.isAlgebraic_adjoin_of_zsmul_cls_eq (hM i) (N := N i) ?_
    rw [natCast_zsmul, natCast_zsmul, ← hb i, ← ha i, smul_smul, smul_smul, mul_comm]

/-- The members of an algebraically independent family are non-zero. -/
theorem ne_zero {v : ι → V l L} (hv : VAlgIndep l v) (i : ι) : v i ≠ 0 := by
  obtain ⟨N, a, _, ha, hind⟩ := hv
  intro h0
  have := ha i
  rw [h0, smul_zero] at this
  exact hind.transcendental i (V.isAlgebraic_of_cls_eq_zero this.symm)

/-- An algebraically independent family is injective. -/
theorem injective {v : ι → V l L} (hv : VAlgIndep l v) : Function.Injective v := by
  obtain ⟨N, a, hN, ha, hind⟩ := hv
  intro i j hij
  by_contra hne
  have halg : IsAlgebraic l⟮(a j : L)⟯ (a i : L) := by
    refine V.isAlgebraic_adjoin_of_zsmul_cls_eq (hN j) (N := N i) ?_
    rw [natCast_zsmul, natCast_zsmul, ← ha i, ← ha j, hij, smul_smul, smul_smul, mul_comm]
  have htr := hind.transcendental_adjoin (s := {j}) (i := i) (by simpa using hne)
  rw [Set.image_singleton] at htr
  exact htr (IntermediateField.isAlgebraic_adjoin_iff.1 halg)

/-- Algebraic independence of `[a i]` is algebraic independence of `a i`. -/
theorem cls_iff {a : ι → Lˣ} :
    VAlgIndep l (fun i ↦ cls (constUnits l L) (.ofMul (a i))) ↔
      AlgebraicIndependent l (fun i ↦ (a i : L)) :=
  iff_of_nsmul_eq_cls (fun _ ↦ one_pos) (fun _ ↦ one_nsmul _)

/-- Algebraic independence is invariant under multiplying each member by a non-zero rational
number. -/
theorem smul_iff {v : ι → V l L} {q : ι → ℚ} (hq : ∀ i, q i ≠ 0) :
    VAlgIndep l (fun i ↦ q i • v i) ↔ VAlgIndep l v := by
  have hN i : 0 < (q i).den * repNat (v i) := Nat.mul_pos (q i).den_pos (repNat_pos _)
  rw [iff_of_nsmul_eq_cls hN (fun i ↦ nsmul_smul_eq_cls (repNat_nsmul (v i)) (q i)),
    iff_of_nsmul_eq_cls (fun i ↦ repNat_pos (v i)) (fun i ↦ repNat_nsmul (v i))]
  have hnum i : (q i).num ≠ 0 := Rat.num_ne_zero.2 (hq i)
  have h1 i : IsAlgebraic l⟮((repUnit (v i) : Lˣ) : L)⟯ ((repUnit (v i) ^ (q i).num : Lˣ) : L) :=
    V.isAlgebraic_adjoin_of_zsmul_cls_eq one_pos (N := (q i).num) (by
      rw [Nat.cast_one, one_smul, cls_zpow])
  have h2 i : IsAlgebraic l⟮((repUnit (v i) ^ (q i).num : Lˣ) : L)⟯ ((repUnit (v i) : Lˣ) : L) :=
    V.isAlgebraic_adjoin_of_zsmul_cls_eq (Int.natAbs_pos.2 (hnum i)) (N := (q i).num.sign) (by
      rw [cls_zpow, smul_smul, Int.sign_mul_self_eq_natAbs])
  exact ⟨fun h ↦ algebraicIndependent_of_isAlgebraic_adjoin h h1 h2,
    fun h ↦ algebraicIndependent_of_isAlgebraic_adjoin h h2 h1⟩

/-- Subfamilies of algebraically independent families are algebraically independent. -/
theorem comp {ι' : Type*} {v : ι → V l L} (hv : VAlgIndep l v) (f : ι' → ι)
    (hf : Function.Injective f) : VAlgIndep l (v ∘ f) := by
  obtain ⟨N, a, hN, ha, hind⟩ := hv
  exact ⟨N ∘ f, a ∘ f, fun i ↦ hN (f i), fun i ↦ ha (f i), hind.comp f hf⟩

end VAlgIndep

end MilnorAlgDep
