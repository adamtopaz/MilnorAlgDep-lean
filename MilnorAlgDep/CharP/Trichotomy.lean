module

public import MilnorAlgDep.CharP.Models
public import MilnorAlgDep.CharP.Normalized

/-!
# The trichotomy

Blueprint, Section 4: Lemma 4.6 (`lem:trichotomy`), element-wise.

Let `B` be a transcendence basis of `L / l`, let `(x, y, z)` be a normalized triple of three
distinct collinear points `P = Q_x, Q = Q_y, R = Q_z`, and let `(i, j, k)` be the heights of
`x, y, z`; these are the heights of the level triple `(lev x, lev y, lev z)` of `(P, Q, R)`. The
blueprint's `ω_A(P)` is `omega l p B x`.

## Main statements

* `IsNormalized.trichotomy_lt` (Lemma 4.6(a)): if `i < j`, then `k = i` and `ω(R) = ω(P)`.
* `IsNormalized.trichotomy_eq_of_omega_ne` (Lemma 4.6(b)): if `i = j` and `ω(P) ≠ ω(Q)`, then
  `k = i` and `ω(R)` is contained in `ω(P) + ω(Q)` and differs from `ω(P)` and `ω(Q)`.
* `IsNormalized.trichotomy_eq_of_omega_eq` (Lemma 4.6(c)): if `i = j` and `ω(P) = ω(Q)`, then
  `k ≥ i`.
* `IsNormalized.hgt_eq_of_omega_ne` (Lemma 4.6(d)): if `ω(P), ω(Q), ω(R)` are pairwise distinct
  then `i = j = k`; equivalently (`isNormalized_of_hgt_eq_zero`) model generators of `P, Q, R`
  form a normalized triple, i.e. `(λ_B(P), λ_B(Q), λ_B(R))` is a level triple of `(P, Q, R)`.

## Proof

As in the blueprint, a diagonal Frobenius twist reduces (a)-(c) to the case `i = 0 ≤ j`. Then `x`
is a model generator, `y ∈ L_B`, and `z ∈ L_B` because it is separable over `l(x, y)`. Instead of
the irreducible relation of `(x, y, z)` we use that each of `x, y, z` is separable over the field
generated by the other two, so that each of `d x, d y, d z` lies in the span of the other two
(`IsNormalized.modelD_mem_sup`, blueprint Lemma 2.3 (S2)); together with `d y = 0` iff `j > 0`
(Lemma 4.3(b)) this gives (a)-(c) by linear algebra. Part (d) is
`isNormalized_of_linearIndependent_modelD`.

## Auxiliary results

* `span_singleton_eq_of_mem`, `span_singleton_ne_of_apply`,
  `linearIndependent_pair_of_span_singleton_ne`, `exists_smul_add_smul_of_mem_sup`: lines in a
  vector space.
* `isSeparable_adjoin_restrictFamily_of_isSeparable`, `modelD_mem_span_of_isSeparable`,
  `modelD_mem_sup_of_isSeparable`, `IsNormalized.modelD_mem_sup`: blueprint Lemma 2.3 (S2) in
  a model.
* `omega_frobZ`: `ω_B(Q_{Frob^j y}) = ω_B(Q_y)`.
-/

@[expose] public section

namespace MilnorAlgDep

open KaehlerDifferential IntermediateField

section Lines

/-! ### Lines in a vector space -/

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- A non-zero vector of the line `K ∙ v` spans it. -/
theorem span_singleton_eq_of_mem {v w : V} (hw : w ≠ 0) (h : w ∈ K ∙ v) : K ∙ w = K ∙ v := by
  obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.1 h
  exact Submodule.span_singleton_smul_eq (left_ne_zero_of_smul hw).isUnit v

/-- Two lines `K ∙ v`, `K ∙ w` are different if a linear form vanishes at `w` but not at `v`. -/
theorem span_singleton_ne_of_apply (f : V →ₗ[K] K) {v w : V} (hv : f v ≠ 0) (hw : f w = 0) :
    K ∙ v ≠ K ∙ w := by
  intro h
  obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.1 (h ▸ Submodule.mem_span_singleton_self v)
  rw [← hr, map_smul, hw, smul_zero] at hv
  exact hv rfl

/-- Two non-zero vectors spanning different lines are linearly independent. -/
theorem linearIndependent_pair_of_span_singleton_ne {v w : V} (hv : v ≠ 0) (hw : w ≠ 0)
    (h : K ∙ v ≠ K ∙ w) : LinearIndependent K ![v, w] := by
  rw [LinearIndependent.pair_iff]
  intro s t hst
  by_cases hs : s = 0
  · subst hs
    rw [zero_smul, zero_add, smul_eq_zero] at hst
    exact ⟨rfl, hst.resolve_right hw⟩
  · refine absurd (span_singleton_eq_of_mem hv
      (Submodule.mem_span_singleton.2 ⟨-(s⁻¹ * t), ?_⟩)) h
    rw [neg_smul, mul_smul, ← smul_neg, ← eq_neg_of_add_eq_zero_left hst, smul_smul,
      inv_mul_cancel₀ hs, one_smul]

/-- If a non-zero vector `u` of the plane `K ∙ v ⊔ K ∙ w` spans a line different from `K ∙ v` and
from `K ∙ w`, then `u = s • v + t • w` with `s, t ≠ 0`. -/
theorem exists_smul_add_smul_of_mem_sup {u v w : V} (hu : u ≠ 0) (h : u ∈ K ∙ v ⊔ K ∙ w)
    (hv : K ∙ u ≠ K ∙ v) (hw : K ∙ u ≠ K ∙ w) :
    ∃ s t : K, s ≠ 0 ∧ t ≠ 0 ∧ u = s • v + t • w := by
  obtain ⟨_, hv', _, hw', rfl⟩ := Submodule.mem_sup.1 h
  obtain ⟨s, rfl⟩ := Submodule.mem_span_singleton.1 hv'
  obtain ⟨t, rfl⟩ := Submodule.mem_span_singleton.1 hw'
  refine ⟨s, t, fun hs ↦ ?_, fun ht ↦ ?_, rfl⟩
  · rw [hs, zero_smul, zero_add] at hu hw
    exact hw (Submodule.span_singleton_smul_eq (left_ne_zero_of_smul hu).isUnit w)
  · rw [ht, zero_smul, add_zero] at hu hv
    exact hv (Submodule.span_singleton_smul_eq (left_ne_zero_of_smul hu).isUnit v)

end Lines

section ModelDifferentials

/-! ### Differentials of separable elements in a model -/

variable {l L : Type*} [Field l] [Field L] [Algebra l L] {ι κ : Type*} {B : ι → L}

-- TODO(move): `MilnorAlgDep.Standard.Differentials.Restrict`.
/-- If `y` lies in an intermediate field `E` containing the `xₖ` and is separable algebraic over
`l(x) ⊆ L`, then it is separable algebraic over `l(x) ⊆ E`. -/
theorem isSeparable_adjoin_restrictFamily_of_isSeparable (E : IntermediateField l L) {x : κ → L}
    (hx : ∀ k, x k ∈ E) {y : L} (hyE : y ∈ E) (hy : IsSeparable (adjoin l (Set.range x)) y) :
    IsSeparable (adjoin l (Set.range (restrictFamily E x hx))) (⟨y, hyE⟩ : E) := by
  set K := adjoin l (Set.range x)
  set K' := adjoin l (Set.range (restrictFamily E x hx))
  have hKE : K ≤ E := adjoin_le_iff.mpr (by rintro _ ⟨k, rfl⟩; exact hx k)
  let incl : K →ₐ[l] E := IntermediateField.inclusion hKE
  have hmap : K'.map E.val = K := by
    rw [adjoin_map, ← Set.range_comp]
    rfl
  have hK' : ∀ k : K, incl k ∈ K' := by
    intro k
    have hk : (k : L) ∈ K'.map E.val := by
      rw [hmap]
      exact k.2
    obtain ⟨z, hz, hzk⟩ := hk
    have : z = incl k := Subtype.ext hzk
    exact this ▸ hz
  let : Algebra K E := incl.toRingHom.toAlgebra
  have : IsScalarTower K E L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  let : Algebra K K' := (incl.toRingHom.codRestrict K'.toSubring hK').toAlgebra
  have : IsScalarTower K K' E := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have h1 : IsSeparable K (⟨y, hyE⟩ : E) :=
    IsSeparable.of_algHom K (IsScalarTower.toAlgHom K E L) hy
  exact h1.tower_top K'

-- TODO(move): `MilnorAlgDep.CharP.Model`.
/-- **Blueprint Lemma 2.3 (S2)** in a model: if `y` is separable algebraic over `l(x)` for a family
`x` of elements of `L_B`, then `y ∈ L_B` and `d y` lies in the `L_B`-span of the `d xₖ` in
`Ω_B`. -/
theorem modelD_mem_span_of_isSeparable {x : κ → L} (hx : ∀ k, x k ∈ model l B) {y : L}
    (hy : IsSeparable (adjoin l (Set.range x)) y) :
    y ∈ model l B ∧
      modelD l B y ∈ Submodule.span (model l B) (Set.range fun k ↦ modelD l B (x k)) := by
  have hKE : adjoin l (Set.range x) ≤ model l B :=
    adjoin_le_iff.mpr (by rintro _ ⟨k, rfl⟩; exact hx k)
  have hyE : y ∈ model l B := mem_model_of_isSeparable hKE hy
  refine ⟨hyE, ?_⟩
  have hfun : (fun k ↦ modelD l B (x k)) = fun k ↦ D l (model l B) (restrictFamily _ x hx k) :=
    funext fun k ↦ modelD_of_mem (hx k)
  rw [modelD_of_mem hyE, hfun]
  exact kaehler_D_mem_span_range_of_isSeparable _
    (isSeparable_adjoin_restrictFamily_of_isSeparable _ hx hyE hy)

-- TODO(move): `MilnorAlgDep.CharP.Model`.
/-- **Blueprint Lemma 2.3 (S2)** in a model, for two elements: if `y, z ∈ L_B` and `x` is
separable algebraic over `l(y, z)`, then `x ∈ L_B` and `d x ∈ L_B d y + L_B d z`. -/
theorem modelD_mem_sup_of_isSeparable {y z x : L} (hy : y ∈ model l B) (hz : z ∈ model l B)
    (hx : IsSeparable l⟮y, z⟯ x) :
    x ∈ model l B ∧ modelD l B x ∈ (model l B ∙ modelD l B y) ⊔ (model l B ∙ modelD l B z) := by
  have hyz : ∀ k, ![y, z] k ∈ model l B := by
    intro k
    fin_cases k
    exacts [hy, hz]
  have hrange : Set.range ![y, z] = {y, z} := Matrix.range_cons_cons_empty y z _
  obtain ⟨hxB, hspan⟩ := modelD_mem_span_of_isSeparable hyz (by rw [hrange]; exact hx)
  refine ⟨hxB, ?_⟩
  have hfun : (fun k ↦ modelD l B (![y, z] k)) = modelD l B ∘ ![y, z] := rfl
  rwa [hfun, Set.range_comp, hrange, Set.image_pair, Submodule.span_insert] at hspan

/-- **Blueprint Lemma 2.3 (S2)** for a normalized triple: if `(x, y, z)` is normalized and
`x, y ∈ L_B`, then `z ∈ L_B`, and each of `d x, d y, d z` lies in the span of the other two. -/
theorem IsNormalized.modelD_mem_sup {x y z : L} (h : IsNormalized l x y z) (hx : x ∈ model l B)
    (hy : y ∈ model l B) :
    z ∈ model l B ∧
      modelD l B x ∈ (model l B ∙ modelD l B y) ⊔ (model l B ∙ modelD l B z) ∧
      modelD l B y ∈ (model l B ∙ modelD l B x) ⊔ (model l B ∙ modelD l B z) ∧
      modelD l B z ∈ (model l B ∙ modelD l B x) ⊔ (model l B ∙ modelD l B y) := by
  obtain ⟨hz, hdz⟩ := modelD_mem_sup_of_isSeparable hx hy h.isSeparable₃
  exact ⟨hz, (modelD_mem_sup_of_isSeparable hy hz h.isSeparable₁).2,
    (modelD_mem_sup_of_isSeparable hx hz h.isSeparable₂).2, hdz⟩

end ModelDifferentials

variable {l L : Type*} [Field l] [Field L] [Algebra l L] {ι : Type*}
variable (p : ℕ) [Fact p.Prime] [CharP L p] [PerfectField L] [IsRelAlgClosed l L]
variable {B : ι → L} {x y z : L}

-- TODO(move): `MilnorAlgDep.CharP.Models`.
/-- `ω_B(Q_{Frob^j y}) = ω_B(Q_y)`: points are stable under Frobenius. -/
theorem omega_frobZ (hB : IsTranscendenceBasis l B) {y : L} (hy : Transcendental l y) (j : ℤ) :
    omega l p B (frobZ L p j y) = omega l p B y :=
  omega_eq_of_samePoint p hB ((samePoint_frobZ_left_iff p j).2 (samePoint_refl hy))

section Untwisted

/-! ### The case `hgt x = 0` -/

/-- Lemma 4.6(a) in the case `i = 0`: if `hgt x = 0 < hgt y`, then `hgt z = 0` and
`ω(R) = ω(P)`. -/
theorem IsNormalized.trichotomy_lt_aux (hB : IsTranscendenceBasis l B) (h : IsNormalized l x y z)
    (hx : hgt l p B x = 0) (hy : 0 < hgt l p B y) :
    hgt l p B z = 0 ∧ omega l p B z = omega l p B x := by
  obtain ⟨hxB, hdx⟩ := (hgt_eq_zero_iff p hB h.transcendental₁).1 hx
  have hyB : y ∈ model l B := (mem_model_iff_hgt_nonneg p hB h.transcendental₂).2 hy.le
  have hdy : modelD l B y = 0 := by
    by_contra hdy
    exact hy.ne' ((hgt_eq_zero_iff p hB h.transcendental₂).2 ⟨hyB, hdy⟩)
  obtain ⟨hzB, hx', -, -⟩ := h.modelD_mem_sup hxB hyB
  rw [hdy, Submodule.span_zero_singleton, bot_sup_eq] at hx'
  have hdz : modelD l B z ≠ 0 := by
    intro hdz
    rw [hdz, Submodule.span_zero_singleton, Submodule.mem_bot] at hx'
    exact hdx hx'
  have hz : hgt l p B z = 0 := (hgt_eq_zero_iff p hB h.transcendental₃).2 ⟨hzB, hdz⟩
  refine ⟨hz, ?_⟩
  rw [omega_eq_span_of_hgt_eq_zero p hz, omega_eq_span_of_hgt_eq_zero p hx]
  exact (span_singleton_eq_of_mem hdx hx').symm

/-- Lemma 4.6(b) in the case `i = 0`. -/
theorem IsNormalized.trichotomy_eq_of_omega_ne_aux (hB : IsTranscendenceBasis l B)
    (h : IsNormalized l x y z) (hx : hgt l p B x = 0) (hy : hgt l p B y = 0)
    (hne : omega l p B x ≠ omega l p B y) :
    hgt l p B z = 0 ∧ omega l p B z ≤ omega l p B x ⊔ omega l p B y ∧
      omega l p B z ≠ omega l p B x ∧ omega l p B z ≠ omega l p B y := by
  obtain ⟨hxB, hdx⟩ := (hgt_eq_zero_iff p hB h.transcendental₁).1 hx
  obtain ⟨hyB, hdy⟩ := (hgt_eq_zero_iff p hB h.transcendental₂).1 hy
  rw [omega_eq_span_of_hgt_eq_zero p hx, omega_eq_span_of_hgt_eq_zero p hy] at hne ⊢
  obtain ⟨hzB, hx', hy', hz'⟩ := h.modelD_mem_sup hxB hyB
  have hdz : modelD l B z ≠ 0 := by
    intro hdz
    rw [hdz, Submodule.span_zero_singleton, sup_bot_eq] at hx'
    exact hne (span_singleton_eq_of_mem hdx hx')
  have hz : hgt l p B z = 0 := (hgt_eq_zero_iff p hB h.transcendental₃).2 ⟨hzB, hdz⟩
  rw [omega_eq_span_of_hgt_eq_zero p hz]
  refine ⟨hz, (Submodule.span_singleton_le_iff_mem _ _).2 hz', fun hzx ↦ ?_, fun hzy ↦ ?_⟩
  · rw [hzx, sup_idem] at hy'
    exact hne (span_singleton_eq_of_mem hdy hy').symm
  · rw [hzy, sup_idem] at hx'
    exact hne (span_singleton_eq_of_mem hdx hx')

/-- Lemma 4.6(c) in the case `i = 0`: if `hgt x = 0 ≤ hgt y`, then `z ∈ L_B`, i.e.
`0 ≤ hgt z`. -/
theorem IsNormalized.hgt_nonneg_aux (hB : IsTranscendenceBasis l B) (h : IsNormalized l x y z)
    (hx : hgt l p B x = 0) (hy : 0 ≤ hgt l p B y) : 0 ≤ hgt l p B z := by
  have hxB := ((hgt_eq_zero_iff p hB h.transcendental₁).1 hx).1
  have hyB := (mem_model_iff_hgt_nonneg p hB h.transcendental₂).2 hy
  exact (mem_model_iff_hgt_nonneg p hB h.transcendental₃).1 (h.modelD_mem_sup hxB hyB).1

end Untwisted

/-- **Blueprint Lemma 4.6(a)**: for a normalized triple `(x, y, z)` with heights `(i, j, k)`, if
`i < j` then `k = i` and `ω(R) = ω(P)`. -/
theorem IsNormalized.trichotomy_lt (hB : IsTranscendenceBasis l B) (h : IsNormalized l x y z)
    (hij : hgt l p B x < hgt l p B y) :
    hgt l p B z = hgt l p B x ∧ omega l p B z = omega l p B x := by
  have h' := (IsNormalized.frobZ_iff p (-hgt l p B x)).2 h
  have := h'.trichotomy_lt_aux p hB (hgt_frobZ_neg_hgt p hB h.transcendental₁)
    (by rw [hgt_frobZ p hB h.transcendental₂]; omega)
  rwa [hgt_frobZ p hB h.transcendental₃, omega_frobZ p hB h.transcendental₃,
    omega_frobZ p hB h.transcendental₁, add_neg_eq_zero] at this

/-- **Blueprint Lemma 4.6(b)**: for a normalized triple `(x, y, z)` with heights `(i, j, k)`, if
`i = j` and `ω(P) ≠ ω(Q)`, then `k = i`, and `ω(R)` is contained in `ω(P) + ω(Q)` and different
from `ω(P)` and `ω(Q)`. -/
theorem IsNormalized.trichotomy_eq_of_omega_ne (hB : IsTranscendenceBasis l B)
    (h : IsNormalized l x y z) (hij : hgt l p B x = hgt l p B y)
    (hne : omega l p B x ≠ omega l p B y) :
    hgt l p B z = hgt l p B x ∧ omega l p B z ≤ omega l p B x ⊔ omega l p B y ∧
      omega l p B z ≠ omega l p B x ∧ omega l p B z ≠ omega l p B y := by
  have h' := (IsNormalized.frobZ_iff p (-hgt l p B x)).2 h
  have := h'.trichotomy_eq_of_omega_ne_aux p hB (hgt_frobZ_neg_hgt p hB h.transcendental₁)
    (by rw [hgt_frobZ p hB h.transcendental₂, hij, add_neg_cancel])
    (by rwa [omega_frobZ p hB h.transcendental₁, omega_frobZ p hB h.transcendental₂])
  rwa [hgt_frobZ p hB h.transcendental₃, omega_frobZ p hB h.transcendental₃,
    omega_frobZ p hB h.transcendental₁, omega_frobZ p hB h.transcendental₂,
    add_neg_eq_zero] at this

/-- **Blueprint Lemma 4.6(c)**: for a normalized triple `(x, y, z)` with heights `(i, j, k)`, if
`i = j` and `ω(P) = ω(Q)`, then `k ≥ i`. (The hypothesis `ω(P) = ω(Q)` is not needed, and
`i ≤ j` suffices.) -/
theorem IsNormalized.trichotomy_eq_of_omega_eq (hB : IsTranscendenceBasis l B)
    (h : IsNormalized l x y z) (hij : hgt l p B x = hgt l p B y)
    (_heq : omega l p B x = omega l p B y) : hgt l p B x ≤ hgt l p B z := by
  have h' := (IsNormalized.frobZ_iff p (-hgt l p B x)).2 h
  have := h'.hgt_nonneg_aux p hB (hgt_frobZ_neg_hgt p hB h.transcendental₁)
    (by rw [hgt_frobZ p hB h.transcendental₂]; omega)
  rw [hgt_frobZ p hB h.transcendental₃] at this
  omega

/-- **Blueprint Lemma 4.6(d)**: if the lines `ω(P), ω(Q), ω(R)` of three distinct collinear points
are pairwise distinct, then model generators `x, y, z` of `P, Q, R` (elements of height `0`) form
a normalized triple, i.e. `(λ_B(P), λ_B(Q), λ_B(R))` is a level triple of `(P, Q, R)`. -/
theorem isNormalized_of_hgt_eq_zero (hB : IsTranscendenceBasis l B)
    (h : IsCollinearTriple l x y z) (hx : hgt l p B x = 0) (hy : hgt l p B y = 0)
    (hz : hgt l p B z = 0) (hxy : omega l p B x ≠ omega l p B y)
    (hxz : omega l p B x ≠ omega l p B z) (hyz : omega l p B y ≠ omega l p B z) :
    IsNormalized l x y z := by
  have := IsRelAlgClosed.perfectField l L
  obtain ⟨hxB, hdx⟩ := (hgt_eq_zero_iff p hB h.transcendental₁).1 hx
  obtain ⟨hyB, hdy⟩ := (hgt_eq_zero_iff p hB h.transcendental₂).1 hy
  obtain ⟨hzB, hdz⟩ := (hgt_eq_zero_iff p hB h.transcendental₃).1 hz
  rw [omega_eq_span_of_hgt_eq_zero p hx, omega_eq_span_of_hgt_eq_zero p hy] at hxy
  rw [omega_eq_span_of_hgt_eq_zero p hx, omega_eq_span_of_hgt_eq_zero p hz] at hxz
  rw [omega_eq_span_of_hgt_eq_zero p hy, omega_eq_span_of_hgt_eq_zero p hz] at hyz
  exact isNormalized_of_linearIndependent_modelD hxB hyB hzB
    (linearIndependent_pair_of_span_singleton_ne hdx hdy hxy)
    (linearIndependent_pair_of_span_singleton_ne hdx hdz hxz)
    (linearIndependent_pair_of_span_singleton_ne hdy hdz hyz) h.isAlgebraic

/-- **Blueprint Lemma 4.6(d)**, in terms of heights: if `(x, y, z)` is normalized and the lines
`ω(P), ω(Q), ω(R)` are pairwise distinct, then the heights `i, j, k` are equal. -/
theorem IsNormalized.hgt_eq_of_omega_ne (hB : IsTranscendenceBasis l B)
    (h : IsNormalized l x y z) (hxy : omega l p B x ≠ omega l p B y)
    (hxz : omega l p B x ≠ omega l p B z) (hyz : omega l p B y ≠ omega l p B z) :
    hgt l p B x = hgt l p B y ∧ hgt l p B y = hgt l p B z := by
  have htx := h.transcendental₁
  have hty := h.transcendental₂
  have htz := h.transcendental₃
  have hx₀ := (samePoint_frobZ_left_iff p (-hgt l p B x)).2 (samePoint_refl htx)
  have hy₀ := (samePoint_frobZ_left_iff p (-hgt l p B y)).2 (samePoint_refl hty)
  have hz₀ := (samePoint_frobZ_left_iff p (-hgt l p B z)).2 (samePoint_refl htz)
  have h₀ := isNormalized_of_hgt_eq_zero p hB (h.toIsCollinearTriple.of_samePoint hx₀ hy₀ hz₀)
    (hgt_frobZ_neg_hgt p hB htx) (hgt_frobZ_neg_hgt p hB hty) (hgt_frobZ_neg_hgt p hB htz)
    (by rwa [omega_frobZ p hB htx, omega_frobZ p hB hty])
    (by rwa [omega_frobZ p hB htx, omega_frobZ p hB htz])
    (by rwa [omega_frobZ p hB hty, omega_frobZ p hB htz])
  have := (h.isNormalized_iff p hx₀ hy₀ hz₀).1 h₀
  rw [levDiff_frobZ_left p (samePoint_refl htx), levDiff_frobZ_left p (samePoint_refl hty),
    levDiff_frobZ_left p (samePoint_refl htz), levDiff_self p htx, levDiff_self p hty,
    levDiff_self p htz] at this
  omega

end MilnorAlgDep
